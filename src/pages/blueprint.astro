---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrutalMedia from '../components/ui/BrutalMedia.astro';
import BrutalFileDownload from '../components/ui/BrutalFileDownload.astro';
import BlueprintDivider from '../components/ui/BlueprintDivider.astro';
import { getCollection } from 'astro:content';
import blueprintContent from '../content/pages/blueprint.json';

const allTestimonials = await getCollection('testimonials');
const sortedTestimonials = allTestimonials.filter(t => t.data.enabled !== false).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const testimonials = sortedTestimonials.slice(0, 2).map((t) => t.data);

const {
  breadcrumb = {
    directory: "/// DIRECTORY: ROOT / 02_BLUEPRINT // DECLASSIFIED CLUB MANUAL",
    securityTier: "SECURITY_TIER: 01 • ARCHIVAL_SEAL_INTACT"
  },
  manifesto = {},
  architecture = {},
  wings = {},
  exitLogs = {}
} = blueprintContent || {};

const archTabs = architecture.tabs || [];
const tab0 = archTabs[0] || { items: [] };
const tab1 = archTabs[1] || { items: [], outputLines: [] };
const tab2 = archTabs[2] || { items: [] };
const tab3 = archTabs[3] || { items: [] };
const plaques = blueprintContent.plaques || blueprintContent.visionMission || {
  enabled: true,
  vision: {
    specTag: "/// SPEC_01: OUR VISION",
    title: "THE STANDARD OF COLLEGIATE MARKETING.",
    body: "To establish an unrivaled benchmark across Asian university institutions—forging visionary leaders who command consumer psychology, technological agility, and fearless aesthetic discipline to reshape global commerce.",
    targetHorizon: "TARGET_HORIZON // 2030_DEPLOYMENT",
    status: "[LOCKED]"
  },
  mission: {
    specTag: "/// SPEC_02: OUR MISSION",
    title: "DISRUPT. ANALYZE. DELIVER.",
    body: "To dismantle conventional marketing pedagogy through relentless hands-on project incubation, high-stakes tactical competitions, data-backed market research, and high-impact industry mentorship for every active club operative.",
    operationalMandate: "OPERATIONAL_MANDATE // SVC_CAMPUS",
    status: "[ACTIVE]"
  }
};
---

<BaseLayout title="BLUEPRINT /// THE MARKETING CLUB (MAC)">
  <!-- 1. BREADCRUMB BAR -->
  <section class="w-full bg-tactical-stone border-b-2 border-stark-black">
    <div class="max-w-[1280px] mx-auto px-3.5 sm:px-6 lg:px-8 py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 bg-stark-black inline-block shrink-0"></span>
        <span class="font-mono text-xs sm:text-sm text-stark-black font-bold uppercase tracking-wider truncate">
          {breadcrumb.directory}
        </span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <span class="font-mono text-[10px] sm:text-[11px] text-stark-black font-bold uppercase bg-pure-white px-2 py-0.5 border border-stark-black shadow-[2px_2px_0px_#000000]">
          {breadcrumb.securityTier}
        </span>
      </div>
    </div>
  </section>

  <!-- MAIN BLUEPRINT CONTENT CONTAINER -->
  <div class="max-w-[1280px] w-full mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-10 sm:space-y-16">
    
    {manifesto.enabled !== false && (
    <!-- 2. SECTION 2.1 — THE CLUB MANIFESTO (2-COLUMN SPLIT FRAME) -->
    <section class="w-full border-4 border-stark-black shadow-[6px_6px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] bg-pure-white">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- LEFT CELL -->
        <div class="lg:col-span-6 p-4 sm:p-6 lg:p-10 flex flex-col justify-between border-b-4 lg:border-b-0 lg:border-r-4 border-stark-black bg-pure-white">
          <div class="space-y-4 sm:space-y-6">
            <div class="inline-flex items-center bg-electric-cyan text-stark-black border-2 border-stark-black px-2.5 sm:px-3 py-1 font-mono text-[11px] sm:text-xs font-bold uppercase shadow-[2px_2px_0px_#000000]">
              {manifesto.estBadge}
            </div>
            <h1 class="font-display text-2xl sm:text-4xl lg:text-5xl text-stark-black font-black uppercase tracking-tight leading-[1.05]">
              {manifesto.headline}
            </h1>
            <div class="space-y-3 sm:space-y-4 font-sans text-sm sm:text-base text-on-surface leading-relaxed">
              {(manifesto.paragraphs || []).map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <!-- Optional Constitution PDF Download Bar -->
            {manifesto.constitutionPdfEnabled !== false && manifesto.constitutionPdfUrl && manifesto.constitutionPdfUrl.trim().length > 0 && manifesto.constitutionPdfUrl.trim() !== '#' && (
              <div class="pt-2">
                <BrutalFileDownload
                  fileUrl={manifesto.constitutionPdfUrl}
                  fileLabel={manifesto.constitutionPdfLabel || "DOWNLOAD SOCIETY CHARTER & CONSTITUTION [PDF]"}
                  fileType="PDF"
                  variant="bar"
                  enabled={manifesto.constitutionPdfEnabled}
                />
              </div>
            )}
          </div>

          <div class="pt-6 sm:pt-8 mt-6 sm:mt-8 border-t-2 border-stark-black flex flex-wrap items-center justify-between gap-3 sm:gap-4">
            <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-on-surface-variant truncate">
              {manifesto.spec}
            </span>
            <span class="bg-mac-yellow text-stark-black font-mono text-[11px] sm:text-xs font-black uppercase px-2.5 py-1 border-2 border-stark-black shadow-[2px_2px_0px_#000000] -rotate-1 shrink-0">
              {manifesto.status}
            </span>
          </div>
        </div>

        <!-- RIGHT CELL -->
        <div class="lg:col-span-6 bg-mac-yellow p-4 sm:p-6 lg:p-8 flex flex-col justify-between">
          <div class="border-2 border-stark-black shadow-[4px_4px_0px_#000000] overflow-hidden bg-stark-black">
            <BrutalMedia
              src={manifesto.mediaImage}
              videoUrl={manifesto.mediaVideoUrl}
              alt="MAC Collective collegiate cohort assembly outdoors at Sri Venkateswara College"
              ratio="auto"
              border={false}
              class="w-full h-[240px] sm:h-[340px] lg:h-[400px]"
              mediaClass="w-full h-[240px] sm:h-[340px] lg:h-[400px] object-cover transition-all duration-300"
            />
          </div>

          <div class="mt-4 sm:mt-6 bg-stark-black text-pure-white border-2 border-stark-black p-3.5 sm:p-4 space-y-2 select-none">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-[11px] sm:text-xs font-bold text-mac-yellow tracking-wider uppercase">
                {manifesto.mediaCaption}
              </span>
              <span class="font-mono text-[9px] sm:text-[10px] bg-pure-white text-stark-black px-1.5 py-0.5 font-black uppercase">
                {manifesto.clearanceStamp || "[ARCHIVAL_CLEARANCE]"}
              </span>
            </div>
            <p class="font-mono text-[10px] sm:text-[11px] text-tactical-stone uppercase tracking-wider">
              {manifesto.mediaSubCaption}
            </p>
          </div>
        </div>
      </div>
    </section>
    )}

    {architecture.enabled !== false && (
      <>
    <!-- CONNECTOR RAIL 2.1 -> 2.2 -->
    <BlueprintDivider tag="STRUCTURAL_ARCHITECTURE" code="SYS_ARCH_02" accent="yellow" class="my-4 sm:my-6" />

    <!-- 3. SECTION 2.2 — CORE ARCHITECTURE (INTERACTIVE 4-TAB FILING CABINET) -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-stark-black">
          {architecture.title}
        </h2>
        <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black bg-tactical-stone px-2 py-1 border border-stark-black self-start sm:self-auto">
          {architecture.badge}
        </span>
      </div>

      <div class="w-full border-4 border-stark-black shadow-[6px_6px_0px_#000000] bg-pure-white">
        <!-- TAB BAR -->
        <div class="grid grid-cols-2 md:grid-cols-4 bg-tactical-stone border-b-4 border-stark-black text-center" id="architecture-tab-bar">
          {archTabs.map((tab, idx) => (
            <button
              type="button"
              data-sfx="snap"
              class={`arch-tab-btn min-h-[46px] h-auto py-2.5 px-2 flex items-center justify-center font-mono text-[11px] sm:text-xs md:text-sm font-bold uppercase border-r-2 border-b-2 md:border-b-0 border-stark-black transition-colors cursor-pointer select-none ${
                idx === 0 
                  ? "bg-mac-yellow text-stark-black shadow-inner" 
                  : "bg-tactical-stone text-stark-black hover:bg-surface-variant"
              }`}
              data-tab-id={tab.id}
            >
              {tab.buttonLabel}
            </button>
          ))}
        </div>

        <!-- CABINET CONTENT PANELS -->
        <div class="p-4 sm:p-6 lg:p-9 bg-pure-white">
          
          <!-- PANEL 1: IDENTITY -->
          <div class="arch-tab-panel grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="tab-identity">
            <!-- Left Schematic Box -->
            <div class="lg:col-span-4 border-2 border-stark-black p-5 bg-surface-container-low shadow-[4px_4px_0px_#000000] relative">
              <div class="flex justify-between items-center border-b-2 border-stark-black pb-2 mb-4">
                <span class="font-mono text-xs font-black text-stark-black">{tab0.schematic}</span>
                <span class="w-3 h-3 bg-system-red border border-stark-black"></span>
              </div>
              <!-- Radar Target Wireframe -->
              <div class="w-full h-44 border-2 border-stark-black bg-tactical-stone flex items-center justify-center relative overflow-hidden mb-5">
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-32 h-32 border border-stark-black/40"></div>
                  <div class="w-20 h-20 border border-stark-black/60"></div>
                  <div class="w-8 h-8 border-2 border-stark-black"></div>
                  <div class="absolute w-full h-[1px] bg-stark-black/60"></div>
                  <div class="absolute h-full w-[1px] bg-stark-black/60"></div>
                </div>
                <span class="font-mono text-xs font-bold bg-mac-yellow text-stark-black px-2 py-1 border border-stark-black z-10">
                  MAC_CORE_VECTOR
                </span>
              </div>
              <div class="space-y-1.5 font-mono text-xs font-bold uppercase text-on-surface">
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>DOC_ID:</span>
                  <span class="text-stark-black">{tab0.docId}</span>
                </div>
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>CLEARANCE:</span>
                  <span class="text-electric-cyan font-black bg-stark-black px-1">{tab0.clearance}</span>
                </div>
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>CLASSIFICATION:</span>
                  <span class="text-stark-black">{tab0.classification}</span>
                </div>
                <div class="flex justify-between pt-1">
                  <span>FOUNDED:</span>
                  <span class="text-system-red">{tab0.founded}</span>
                </div>
              </div>
            </div>

            <!-- Right Editorial Content -->
            <div class="lg:col-span-8 space-y-6">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-system-red">
                  {tab0.pillarTag}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-stark-black mt-1">
                  {tab0.title}
                </h3>
              </div>
              <div class="space-y-3 font-sans text-sm sm:text-base text-on-surface">
                {(tab0.items || []).map((item) => (
                  <div class="border-2 border-stark-black p-4 bg-tactical-stone shadow-[2px_2px_0px_#000000]">
                    <strong class="font-mono text-xs sm:text-sm font-black text-stark-black uppercase">{item.label}</strong>{" "}
                    {item.text}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- PANEL 2: WORK -->
          <div class="arch-tab-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="tab-work">
            <div class="lg:col-span-4 border-2 border-stark-black p-5 bg-surface-container-low shadow-[4px_4px_0px_#000000]">
              <div class="flex justify-between items-center border-b-2 border-stark-black pb-2 mb-4">
                <span class="font-mono text-xs font-black text-stark-black">{tab1.schematic}</span>
                <span class="w-3 h-3 bg-system-blue border border-stark-black"></span>
              </div>
              <div class="w-full h-44 border-2 border-stark-black bg-stark-black text-pure-white p-3 font-mono text-xs space-y-2 mb-5">
                {tab1.outputLines?.map((line, idx) => (
                  <div class={idx === 1 ? "text-mac-yellow" : idx === 2 ? "text-tactical-stone" : "text-electric-cyan"}>
                    {line}
                  </div>
                ))}
              </div>
              <div class="space-y-1.5 font-mono text-xs font-bold uppercase text-on-surface">
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>DOC_ID:</span>
                  <span class="text-stark-black">{tab1.docId}</span>
                </div>
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>FOCUS:</span>
                  <span class="text-system-blue">{tab1.focus}</span>
                </div>
                <div class="flex justify-between pt-1">
                  <span>STATUS:</span>
                  <span class="text-system-red">{tab1.status}</span>
                </div>
              </div>
            </div>

            <div class="lg:col-span-8 space-y-6">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-system-blue">
                  {tab1.pillarTag}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-stark-black mt-1">
                  {tab1.title}
                </h3>
              </div>
              <div class="space-y-3 font-sans text-sm sm:text-base text-on-surface">
                {(tab1.items || []).map((item) => (
                  <div class="border-2 border-stark-black p-4 bg-tactical-stone shadow-[2px_2px_0px_#000000]">
                    <strong class="font-mono text-xs sm:text-sm font-black text-stark-black uppercase">{item.label}</strong>{" "}
                    {item.text}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- PANEL 3: APPROACH -->
          <div class="arch-tab-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="tab-approach">
            <div class="lg:col-span-4 border-2 border-stark-black p-5 bg-surface-container-low shadow-[4px_4px_0px_#000000]">
              <div class="flex justify-between items-center border-b-2 border-stark-black pb-2 mb-4">
                <span class="font-mono text-xs font-black text-stark-black">{tab2.schematic}</span>
                <span class="w-3 h-3 bg-mac-yellow border border-stark-black"></span>
              </div>
              <div class="w-full h-44 border-2 border-stark-black bg-surface-container p-3 font-mono text-xs flex flex-col justify-center items-center text-center space-y-2 mb-5">
                <span class="font-display text-xl font-black text-stark-black">{tab2.boxHeading}</span>
                <span class="text-on-surface-variant font-bold text-[11px]">{tab2.boxSub}</span>
              </div>
              <div class="space-y-1.5 font-mono text-xs font-bold uppercase text-on-surface">
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>DOC_ID:</span>
                  <span class="text-stark-black">{tab2.docId}</span>
                </div>
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>METHODOLOGY:</span>
                  <span class="text-system-blue">{tab2.methodology}</span>
                </div>
                <div class="flex justify-between pt-1">
                  <span>CADENCE:</span>
                  <span class="text-system-red">{tab2.cadence}</span>
                </div>
              </div>
            </div>

            <div class="lg:col-span-8 space-y-6">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-mac-yellow bg-stark-black px-1">
                  {tab2.pillarTag}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-stark-black mt-1">
                  {tab2.title}
                </h3>
              </div>
              <div class="space-y-3 font-sans text-sm sm:text-base text-on-surface">
                {(tab2.items || []).map((item) => (
                  <div class="border-2 border-stark-black p-4 bg-tactical-stone shadow-[2px_2px_0px_#000000]">
                    <strong class="font-mono text-xs sm:text-sm font-black text-stark-black uppercase">{item.label}</strong>{" "}
                    {item.text}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- PANEL 4: PHILOSOPHY -->
          <div class="arch-tab-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="tab-philosophy">
            <div class="lg:col-span-4 border-2 border-stark-black p-5 bg-surface-container-low shadow-[4px_4px_0px_#000000]">
              <div class="flex justify-between items-center border-b-2 border-stark-black pb-2 mb-4">
                <span class="font-mono text-xs font-black text-stark-black">{tab3.schematic}</span>
                <span class="w-3 h-3 bg-electric-cyan border border-stark-black"></span>
              </div>
              <div class="w-full h-44 border-2 border-stark-black bg-secondary-fixed p-3 flex flex-col justify-center items-center text-center space-y-2 mb-5">
                <span class="font-mono text-sm font-black text-stark-black">{tab3.boxHeading}</span>
                <span class="font-mono text-xs text-stark-black">{tab3.boxSub}</span>
              </div>
              <div class="space-y-1.5 font-mono text-xs font-bold uppercase text-on-surface">
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>DOC_ID:</span>
                  <span class="text-stark-black">{tab3.docId}</span>
                </div>
                <div class="flex justify-between border-b border-outline-variant pb-1">
                  <span>ETHOS:</span>
                  <span class="text-electric-cyan font-black bg-stark-black px-1">{tab3.ethos}</span>
                </div>
                <div class="flex justify-between pt-1">
                  <span>MANDATE:</span>
                  <span class="text-system-red">{tab3.mandate}</span>
                </div>
              </div>
            </div>

            <div class="lg:col-span-8 space-y-6">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-primary">
                  {tab3.pillarTag}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-stark-black mt-1">
                  {tab3.title}
                </h3>
              </div>
              <div class="space-y-3 font-sans text-sm sm:text-base text-on-surface">
                {(tab3.items || []).map((item) => (
                  <div class="border-2 border-stark-black p-4 bg-tactical-stone shadow-[2px_2px_0px_#000000]">
                    <strong class="font-mono text-xs sm:text-sm font-black text-stark-black uppercase">{item.label}</strong>{" "}
                    {item.text}
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
      </>
    )}

    {plaques.enabled !== false && (
      <>
    <!-- CONNECTOR RAIL 2.2 -> 2.3 -->
    <BlueprintDivider tag="CHARTER_DOCTRINE" code="PLAQUE_SYS_03" accent="cyan" class="my-4 sm:my-6" />

    <!-- 4. SECTION 2.3 — VISION & MISSION BLUEPRINT PLAQUES -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
      <!-- VISION PLAQUE -->
      <div class="border-4 border-stark-black shadow-[6px_6px_0px_#000000] bg-pure-white flex flex-col justify-between">
        <div>
          <!-- Black Header Bar -->
          <div class="h-10 bg-stark-black px-3.5 sm:px-4 flex items-center justify-between border-b-2 border-stark-black">
            <span class="font-mono text-xs font-bold uppercase text-electric-cyan tracking-wider truncate">
              {plaques.vision.specTag}
            </span>
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-electric-cyan border border-stark-black shrink-0"></span>
          </div>
          <!-- Body -->
          <div class="p-4 sm:p-6 lg:p-8 space-y-3 sm:space-y-4">
            <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-black uppercase text-stark-black tracking-tight">
              {plaques.vision.title}
            </h3>
            <p class="font-sans text-sm sm:text-base text-on-surface leading-relaxed">
              {plaques.vision.body}
            </p>
          </div>
        </div>
        <div class="px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 bg-tactical-stone border-t-2 border-stark-black flex items-center justify-between">
          <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black">
            {plaques.vision.targetHorizon}
          </span>
          <span class="font-mono text-[11px] sm:text-xs font-black text-system-red">
            {plaques.vision.status}
          </span>
        </div>
      </div>

      <!-- MISSION PLAQUE -->
      <div class="border-4 border-stark-black shadow-[6px_6px_0px_#000000] bg-pure-white flex flex-col justify-between">
        <div>
          <!-- Black Header Bar -->
          <div class="h-10 bg-stark-black px-3.5 sm:px-4 flex items-center justify-between border-b-2 border-stark-black">
            <span class="font-mono text-xs font-bold uppercase text-mac-yellow tracking-wider truncate">
              {plaques.mission.specTag}
            </span>
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-mac-yellow border border-stark-black shrink-0"></span>
          </div>
          <!-- Body -->
          <div class="p-4 sm:p-6 lg:p-8 space-y-3 sm:space-y-4">
            <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-black uppercase text-stark-black tracking-tight">
              {plaques.mission.title}
            </h3>
            <p class="font-sans text-sm sm:text-base text-on-surface leading-relaxed">
              {plaques.mission.body}
            </p>
          </div>
        </div>
        <div class="px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 bg-tactical-stone border-t-2 border-stark-black flex items-center justify-between">
          <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black">
            {plaques.mission.operationalMandate}
          </span>
          <span class="font-mono text-[11px] sm:text-xs font-black text-system-blue">
            {plaques.mission.status}
          </span>
        </div>
      </div>
    </section>
      </>
    )}

    {wings.enabled !== false && (
      <>
    <!-- CONNECTOR RAIL 2.3 -> 2.4 -->
    <BlueprintDivider tag="DEPARTMENT_REGISTRY" code="WINGS_SPEC_04" accent="red" class="my-4 sm:my-6" />

    <!-- 5. SECTION 2.4 — OPERATIONAL WINGS // SPEC SHEET (4 STACKED TABLE ROWS) -->
    <section id="departments" class="space-y-4 scroll-mt-28">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-stark-black">
          {wings.title}
        </h2>
        <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black bg-tactical-stone px-2 py-1 border border-stark-black self-start sm:self-auto">
          {wings.badge}
        </span>
      </div>

      <div class="w-full border-4 border-stark-black shadow-[6px_6px_0px_#000000] bg-pure-white divide-y-2 divide-stark-black">
        {(wings.divisions || []).filter((div) => div.enabled !== false).map((div) => {
          const badgeBg = 
            div.colorScheme === "yellow" ? "bg-mac-yellow text-stark-black" :
            div.colorScheme === "cyan" ? "bg-electric-cyan text-stark-black" :
            div.colorScheme === "red" ? "bg-system-red text-pure-white" :
            div.colorScheme === "stone" ? "bg-tactical-stone text-stark-black" :
            div.colorScheme === "white" ? "bg-pure-white text-stark-black" :
            (div.colorScheme && div.colorScheme.startsWith("bg-") ? div.colorScheme : "bg-pure-white text-stark-black");

          return (
            <div class="p-4 sm:p-6 lg:p-8 grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-start md:items-center hover:bg-surface-container-low transition-colors">
              <div class="md:col-span-3 flex md:flex-col items-start gap-2">
                <span class={`font-mono text-[11px] sm:text-xs font-black uppercase px-2.5 py-1 border-2 border-stark-black shadow-[2px_2px_0px_#000000] ${badgeBg}`}>
                  {div.deptTag}
                </span>
              </div>
              <div class="md:col-span-5 space-y-1">
                <h4 class="font-display text-lg sm:text-2xl font-black uppercase text-stark-black">
                  {div.name}
                </h4>
                <p class="font-sans text-xs sm:text-base text-on-surface-variant">
                  {div.description}
                </p>
                {div.sampleWorkEnabled !== false && div.sampleWorkUrl && div.sampleWorkUrl.trim().length > 0 && div.sampleWorkUrl.trim() !== '#' && (
                  <div class="pt-2">
                    <BrutalFileDownload
                      fileUrl={div.sampleWorkUrl}
                      fileLabel="SAMPLE WORK REPORT"
                      fileType="PDF"
                      enabled={div.sampleWorkEnabled}
                    />
                  </div>
                )}
              </div>
              <div class="md:col-span-4 flex flex-wrap gap-1.5 sm:gap-2 justify-start md:justify-end">
                {(div.skills || []).map((skill) => (
                  <span class="font-mono text-[11px] sm:text-xs font-bold uppercase bg-pure-white text-stark-black px-2 py-0.5 sm:py-1 border-2 border-stark-black shadow-[2px_2px_0px_#000000]">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>
      </>
    )}

    {exitLogs.enabled !== false && (
      <>
    <!-- CONNECTOR RAIL 2.4 -> 2.5 -->
    <BlueprintDivider tag="LEADERSHIP_ARCHIVES" code="EXIT_LOGS_05" accent="black" class="my-4 sm:my-6" />

    <!-- 6. SECTION 2.5 — DECLASSIFIED EXIT LOGS // PAST LEADERSHIP -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-stark-black">
          {exitLogs.title}
        </h2>
        <span class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black bg-tactical-stone px-2 py-1 border border-stark-black self-start sm:self-auto">
          {exitLogs.badge}
        </span>
      </div>

      <div class="space-y-6">
        {testimonials.map((person, idx) => (
          <div class="border-4 border-stark-black shadow-[6px_6px_0px_#000000] bg-pure-white p-4 sm:p-6 lg:p-8">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 items-start">
              
              <!-- Left Portrait -->
              <div class="md:col-span-3">
                <div class="relative border-2 border-stark-black bg-stark-black shadow-[4px_4px_0px_#000000] aspect-square overflow-hidden max-w-[240px] sm:max-w-none">
                  <BrutalMedia
                    src={person.portraitImage}
                    videoUrl={person.videoTestimonialUrl}
                    alt={`${person.name} ${person.role}`}
                    ratio="1/1"
                    border={false}
                    class="w-full h-full"
                    mediaClass="w-full h-full object-cover"
                  />
                  <div class="absolute bottom-2 left-2 bg-stark-black text-pure-white font-mono text-[11px] sm:text-xs font-bold px-2 py-0.5 border border-pure-white z-10">
                    {person.badgeId}
                  </div>
                </div>
              </div>

              <!-- Right Overview & Collapsible Drawer -->
              <div class="md:col-span-9 flex flex-col justify-between h-full space-y-3 sm:space-y-4">
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-black uppercase text-stark-black">
                      {person.name}
                    </h3>
                    <span class={`font-mono text-xs font-bold uppercase ${idx === 0 ? "text-system-red" : "text-electric-cyan font-black bg-stark-black px-1"}`}>
                      /// {person.role}
                    </span>
                  </div>
                  <div class="mt-2.5 sm:mt-3 p-3.5 sm:p-4 bg-tactical-stone border-2 border-stark-black">
                    <p class="font-sans text-xs sm:text-sm md:text-base text-stark-black italic leading-relaxed">
                      {person.pullQuote}
                    </p>
                  </div>
                </div>

                <!-- Collapsible Drawer Container -->
                <div
                  id={`drawer-person-${idx}`}
                  class={`border-2 border-stark-black bg-surface-container-low p-4 sm:p-5 space-y-3 font-sans text-xs sm:text-sm md:text-base text-on-surface ${
                    person.defaultOpen ? "block" : "hidden"
                  }`}
                >
                  {(person.fullLetter || []).map((para: string) => (
                    <p>{para}</p>
                  ))}
                </div>

                <!-- Controls: Expand/Collapse Button & LinkedIn Link -->
                <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-2">
                  <button
                    type="button"
                    data-sfx="snap"
                    class={`font-mono text-xs sm:text-sm font-bold uppercase px-3.5 sm:px-4 py-2 border-2 border-stark-black shadow-[4px_4px_0px_#000000] cursor-pointer select-none transition-colors dossier-toggle-btn ${
                      person.defaultOpen
                        ? "bg-stark-black text-mac-yellow hover:bg-mac-yellow hover:text-stark-black"
                        : "bg-mac-yellow text-stark-black hover:bg-stark-black hover:text-mac-yellow"
                    }`}
                    data-drawer-id={`drawer-person-${idx}`}
                    data-open-text={exitLogs.dossierOpenText || "[ READ FULL DOSSIER + ]"}
                    data-close-text={exitLogs.dossierCloseText || "[ CLOSE DOSSIER - ]"}
                  >
                    {person.defaultOpen ? (exitLogs.dossierCloseText || "[ CLOSE DOSSIER - ]") : (exitLogs.dossierOpenText || "[ READ FULL DOSSIER + ]")}
                  </button>

                  {person.linkedinUrl && (
                    <a
                      href={person.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-xs sm:text-sm font-bold uppercase bg-pure-white text-stark-black px-3.5 sm:px-4 py-2 border-2 border-stark-black shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-pure-white active:translate-x-1 active:translate-y-1 active:shadow-none transition-all"
                    >
                      {exitLogs.linkedinText || "[ LINKEDIN ↗ ]"}
                    </a>
                  )}
                </div>

              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- READ ALL TESTIMONIALS ACTION BUTTON -->
      <div class="pt-4 flex justify-start">
        <a
          href={exitLogs.readAllButtonUrl || "/testimonials"}
          class="arcade-btn bg-mac-yellow text-stark-black px-5 sm:px-6 py-3 sm:py-3.5 border-4 border-stark-black font-mono text-xs sm:text-sm font-bold uppercase shadow-[6px_6px_0px_#000000] hover:bg-stark-black hover:text-mac-yellow flex items-center gap-2.5 active:translate-x-1 active:translate-y-1 active:shadow-none w-full sm:w-auto justify-center"
        >
          <span>{exitLogs.readAllButtonText || "READ ALL TESTIMONIALS ->"}</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
      </>
    )}

  </div>

  <!-- CLIENT SCRIPT: Interactive Pillar Tabs & Dossier Accordions -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // 1. Core Architecture Tab Switching
      const tabButtons = document.querySelectorAll('.arch-tab-btn');
      const tabPanels = document.querySelectorAll('.arch-tab-panel');

      tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const targetId = btn.getAttribute('data-tab-id');

          // Reset all buttons
          tabButtons.forEach(function(b) {
            b.classList.remove('bg-mac-yellow', 'shadow-inner');
            b.classList.add('bg-tactical-stone');
          });

          // Set active button
          btn.classList.remove('bg-tactical-stone');
          btn.classList.add('bg-mac-yellow', 'shadow-inner');

          // Switch panels
          tabPanels.forEach(function(panel) {
            if (panel.id === targetId) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });

      // 2. Dossier Drawers Toggle
      const toggleButtons = document.querySelectorAll('.dossier-toggle-btn');
      toggleButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const drawerId = btn.getAttribute('data-drawer-id');
          if (!drawerId) return;
          const drawer = document.getElementById(drawerId);
          if (!drawer) return;

          const isHidden = drawer.classList.contains('hidden');
          const openText = btn.getAttribute('data-open-text') || '[ READ FULL DOSSIER + ]';
          const closeText = btn.getAttribute('data-close-text') || '[ CLOSE DOSSIER - ]';

          if (isHidden) {
            // Open drawer
            drawer.classList.remove('hidden');
            btn.textContent = closeText;
            btn.classList.remove('bg-mac-yellow', 'text-stark-black');
            btn.classList.add('bg-stark-black', 'text-mac-yellow');
          } else {
            // Close drawer
            drawer.classList.add('hidden');
            btn.textContent = openText;
            btn.classList.remove('bg-stark-black', 'text-mac-yellow');
            btn.classList.add('bg-mac-yellow', 'text-stark-black');
          }
        });
      });
    });
  </script>
</BaseLayout>

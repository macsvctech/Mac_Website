---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrutalMedia from '../components/ui/BrutalMedia.astro';
import BrutalFileDownload from '../components/ui/BrutalFileDownload.astro';
import BlueprintDivider from '../components/ui/BlueprintDivider.astro';
import homeContent from '../content/pages/home.json';

const {
  hero = {},
  receipts = {},
  machinery = {},
  sponsors = {},
  freshPress = {}
} = homeContent || {};

const flagship = (freshPress && freshPress.flagship) || {};
const intelFeed = (freshPress && freshPress.intel) || {};

const rawDepts = machinery.departments || [];
const dept0 = rawDepts[0] || { name: "GROWTH & OUTREACH", description: "", tag: "", meta: "" };
const dept1 = rawDepts[1] || { name: "SOCIAL MEDIA & PR", description: "", tag: "", meta: "" };
const dept2 = rawDepts[2] || { name: "EVENTS & LOGISTICS", description: "", tag: "", meta: "" };
const dept3 = rawDepts[3] || { code: "SUB_DEP_4A", name: "TECHNICAL & RESEARCH", description: "", tag: "" };
const dept4 = rawDepts[4] || { code: "SUB_DEP_4B", name: "CREATIVE STUDIO", description: "", tag: "" };
---

<BaseLayout>
  <div class="w-full max-w-[1280px] mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-10 flex flex-col">
    
    <!-- =========================================================================
         SECTION 1.1 — HERO SPLIT CONTAINER
         ========================================================================= -->
    <section class="w-full bg-tactical-stone border-4 border-stark-black shadow-[6px_6px_0px_#000000] p-4 sm:p-8 lg:p-10 mb-8 sm:mb-10 relative overflow-hidden sm:overflow-visible">
      <!-- Blueprint Technical Corner Registration Crosshairs -->
      <span class="hidden sm:block absolute -top-3.5 -left-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:block absolute -top-3.5 -right-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:block absolute -bottom-3.5 -left-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:block absolute -bottom-3.5 -right-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>

      <!-- Dossier Technical Tab Header -->
      <div class="flex flex-wrap items-center justify-between border-b-2 border-stark-black pb-3 sm:pb-4 mb-5 sm:mb-8 gap-2">
        <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
          <span class="inline-block w-2.5 h-2.5 sm:w-3 sm:h-3 bg-system-red border border-stark-black shrink-0"></span>
          <span class="inline-block w-2.5 h-2.5 sm:w-3 sm:h-3 bg-mac-yellow border border-stark-black shrink-0"></span>
          <span class="inline-block w-2.5 h-2.5 sm:w-3 sm:h-3 bg-electric-cyan border border-stark-black shrink-0"></span>
          <span class="font-mono text-[11px] sm:text-xs lg:text-[13px] font-bold text-stark-black uppercase tracking-wider ml-1 sm:ml-2 truncate">
            {hero.archiveRef}
          </span>
        </div>
        <div class="font-mono text-[10px] sm:text-xs bg-stark-black text-mac-yellow px-2 py-1 font-bold select-none shrink-0">
          {hero.status}
        </div>
      </div>

      <!-- 2-Column Split Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
        
        <!-- LEFT OVERLAPPING CARD -->
        <div class="lg:col-span-6 bg-pure-white border-2 border-stark-black p-4 sm:p-8 lg:p-10 flex flex-col justify-between shadow-[4px_4px_0px_#000000] relative">
          <div class="flex flex-col gap-4 sm:gap-6">
            <!-- Top Tag Sticker -->
            <div class="self-start">
              <span class="inline-block bg-electric-cyan text-stark-black border-2 border-stark-black font-mono text-[11px] sm:text-xs font-bold px-2.5 sm:px-3 py-1 -rotate-2 shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] select-none">
                {hero.estBadge}
              </span>
            </div>

            <!-- Main Stacked Headline -->
            <h1 class="flex flex-col font-display text-[38px] xs:text-[46px] sm:text-[68px] lg:text-[80px] leading-[0.95] tracking-[-0.03em] uppercase font-black break-words">
              <span class="text-stark-black">{hero.headlinePrefix}</span>
              <span class="text-mac-yellow drop-shadow-[3px_3px_0px_#000000] sm:drop-shadow-[4px_4px_0px_#000000] [text-shadow:_1.5px_1.5px_0_#000000,_-1.5px_-1.5px_0_#000000,_1.5px_-1.5px_0_#000000,_-1.5px_1.5px_0_#000000] sm:[text-shadow:_2px_2px_0_#000000,_-2px_-2px_0_#000000,_2px_-2px_0_#000000,_-2px_2px_0_#000000]">
                {hero.headlineHighlight}
              </span>
            </h1>

            <!-- Body Copy -->
            <p class="font-sans text-sm sm:text-lg text-on-surface font-medium leading-relaxed max-w-xl">
              {hero.description}
            </p>
          </div>

          <!-- CTA Trigger Action Area -->
          <div class="pt-6 sm:pt-8 mt-6 border-t-2 border-stark-black flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href={hero.primaryCta.link}
              class="inline-flex items-center justify-center font-mono text-sm sm:text-base uppercase font-bold bg-electric-cyan text-stark-black border-2 border-stark-black px-5 sm:px-6 py-3.5 sm:py-4 shadow-[4px_4px_0px_#000000] sm:shadow-[6px_6px_0px_#000000] hover:bg-stark-black hover:text-electric-cyan hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_#000000] active:translate-x-1.5 active:translate-y-1.5 active:shadow-none transition-none cursor-pointer text-center"
            >
              {hero.primaryCta.text}
            </a>
            <a
              href={hero.secondaryCta.link}
              class="inline-flex items-center justify-center font-mono text-xs sm:text-sm uppercase font-bold bg-tactical-stone text-stark-black border-2 border-stark-black px-4 sm:px-5 py-3.5 sm:py-4 shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-pure-white transition-none cursor-pointer text-center"
            >
              {hero.secondaryCta.text}
            </a>
          </div>
        </div>

        <!-- RIGHT VISUAL FRAME -->
        <div class="lg:col-span-6 relative border-2 border-stark-black bg-stark-black min-h-[280px] sm:min-h-[380px] lg:min-h-[460px] flex items-center justify-center overflow-hidden sm:overflow-visible">
          <!-- Visual Halftone Asset or Video Loop with BrutalMedia multimodal auto-detection -->
          <BrutalMedia
            src={hero.image}
            videoUrl={hero.videoUrl}
            poster={hero.poster}
            alt={hero.imageAlt}
            ratio="auto"
            border={false}
            class="w-full h-full min-h-[280px] sm:min-h-[380px] lg:min-h-[460px]"
            mediaClass="w-full h-full min-h-[280px] sm:min-h-[380px] lg:min-h-[460px] object-cover border-none"
          />

          <!-- Halftone Overlay Noise Accent Bar -->
          <div class="absolute top-0 left-0 right-0 bg-stark-black text-pure-white font-mono text-[10px] sm:text-[11px] px-2.5 sm:px-3 py-1 border-b-2 border-stark-black flex justify-between items-center z-10 opacity-90 select-none">
            <span class="truncate">{hero.imageTag}</span>
            <span class="text-mac-yellow shrink-0 ml-2">{hero.imageTagSub}</span>
          </div>

          <!-- Overlapping Top-Right Quote Sticker -->
          <div data-sfx="thock" role="button" tabindex="0" title="CLICK FOR TACTILE SNAP" class="absolute -top-3 right-2 sm:-top-4 sm:-right-4 z-20 rotate-2 sm:rotate-3 max-w-[210px] sm:max-w-[260px] bg-pure-white border-2 border-stark-black p-2.5 sm:p-3 shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] select-none sticker-interactive">
            <p class="font-mono text-xs sm:text-[13px] font-bold text-stark-black leading-tight">
              {hero.quoteSticker}
            </p>
            <span class="block mt-1 font-mono text-[9px] sm:text-[10px] text-on-surface-variant font-semibold uppercase">
              {hero.quoteStickerSub}
            </span>
          </div>

          <!-- Overlapping Bottom-Center Stat Sticker -->
          <div data-sfx="thock" role="button" tabindex="0" title="CLICK FOR TACTILE SNAP" class="absolute -bottom-4 sm:-bottom-5 left-1/2 -translate-x-1/2 z-20 -rotate-[3deg] sm:-rotate-[4deg] bg-system-red border-2 border-stark-black px-4 sm:px-6 py-1.5 sm:py-2 shadow-[4px_4px_0px_#000000] sm:shadow-[6px_6px_0px_#000000] select-none max-w-[90%] sticker-interactive">
            <span class="font-display font-extrabold text-base sm:text-2xl text-pure-white tracking-tight uppercase whitespace-nowrap">
              {hero.statSticker}
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION CONNECTOR RAIL -->
    <BlueprintDivider tag="IMPACT_RECEIPTS // VERIFIED_METRICS" code="TEL_01.2" accent="yellow" />

    <!-- =========================================================================
         SECTION 1.2 — "THE RECEIPTS" (5-CELL IMPACT COUNTER STRIP)
         ========================================================================= -->
    <section class="w-full mb-8 sm:mb-12 flex flex-col">
      <!-- Terminal Bar Tag Label -->
      <div class="flex items-center justify-between mb-2">
        <div class="font-mono text-xs sm:text-sm font-bold text-stark-black uppercase tracking-wider bg-tactical-stone border-2 border-stark-black px-3 py-1 shadow-[2px_2px_0px_#000000] inline-flex items-center gap-2 select-none">
          <span class="w-2 h-2 bg-mac-yellow inline-block"></span>
          {receipts.sectionTag}
        </div>
        <div class="hidden sm:block font-mono text-xs text-on-surface-variant font-bold uppercase select-none">
          {receipts.sectionLoc}
        </div>
      </div>

      <!-- 5-Cell Collapsed Border Data Table Grid with Flat Hover-Swap -->
      <div class="w-full border-4 border-stark-black shadow-[6px_6px_0px_#000000] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-stark-black bg-pure-white">
        {(receipts.metrics || []).filter((m) => m.enabled !== false).map((metric, idx) => (
          <div
            data-sfx="scaleTick"
            data-scale-index={idx}
            class={`receipt-cell p-4 sm:p-6 lg:p-7 flex flex-col justify-between transition-colors cursor-pointer group ${
              metric.defaultActive
                ? "bg-mac-yellow text-stark-black hover:bg-stark-black hover:text-mac-yellow"
                : "bg-pure-white text-stark-black hover:bg-mac-yellow hover:text-stark-black"
            }`}
          >
            <div>
              <span class={`font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider block ${
                metric.defaultActive 
                  ? "opacity-80 group-hover:text-mac-yellow" 
                  : "text-on-surface-variant group-hover:text-stark-black"
              }`}>
                /// {metric.id}
              </span>
              <div class={`font-display text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mt-2 sm:mt-3 mb-1.5 sm:mb-2 ${
                metric.defaultActive ? "text-stark-black group-hover:text-mac-yellow" : "text-stark-black"
              }`}>
                {metric.value}
              </div>
            </div>
            <div class={`font-mono text-[11px] sm:text-xs lg:text-sm font-bold uppercase tracking-wider pt-2.5 sm:pt-3 border-t-2 ${
              metric.defaultActive ? "border-stark-black group-hover:border-mac-yellow" : "border-stark-black"
            }`}>
              {metric.label}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION CONNECTOR RAIL -->
    <BlueprintDivider tag="DEPARTMENTAL_UNITS // 4_DIVISIONS" code="TEL_01.3" accent="cyan" />

    <!-- =========================================================================
         SECTION 1.3 — "THE MACHINERY" (DEPARTMENTS BENTO GRID)
         ========================================================================= -->
    <section class="w-full mb-8 sm:mb-12 flex flex-col">
      <!-- Section Header Bar -->
      <div class="w-full flex flex-col sm:flex-row sm:items-center justify-between border-b-4 border-stark-black pb-3 sm:pb-4 mb-6 sm:mb-8 gap-3">
        <h2 class="font-display text-[26px] sm:text-[36px] lg:text-[48px] leading-tight font-black uppercase text-stark-black tracking-[-0.03em]">
          {machinery.title}
        </h2>
        <a 
          href={machinery.link}
          class="bg-stark-black text-pure-white font-mono text-xs sm:text-sm font-bold uppercase px-3.5 sm:px-4 py-2 border-2 border-stark-black tracking-wider shadow-[3px_3px_0px_#000000] hover:bg-mac-yellow hover:text-stark-black transition-colors self-start sm:self-auto"
        >
          {machinery.badge}
        </a>
      </div>

      <!-- Bento Grid (Row 1: 8 + 4 cols | Row 2: 4 + 8 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 w-full items-stretch">
        
        <!-- ROW 1, LEFT CARD (8 COLS): Growth & Outreach (Electric Cyan) -->
        <a
          href={machinery.link}
          class="paper-lift lg:col-span-8 bg-[#00E5FF] border-2 border-stark-black p-4 sm:p-6 lg:p-8 flex flex-col justify-between shadow-[6px_6px_0px_#000000] group cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="bg-pure-white border-2 border-stark-black p-2.5 sm:p-3 shadow-[2px_2px_0px_#000000] inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-stark-black text-[24px] sm:text-[28px]">query_stats</span>
              </div>
              <span class="font-mono text-xs sm:text-sm font-bold text-stark-black uppercase tracking-wider">DEP_01</span>
            </div>
            <h3 class="font-display text-[22px] sm:text-[28px] lg:text-[32px] leading-tight font-extrabold uppercase text-stark-black mb-2 sm:mb-3">
              {dept0.name}
            </h3>
            <p class="font-sans text-on-surface text-sm sm:text-base lg:text-[17px] leading-relaxed max-w-2xl font-medium">
              {dept0.description}
            </p>
          </div>
          <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t-2 border-stark-black flex items-center justify-between">
            <span class="font-mono font-bold uppercase text-stark-black bg-pure-white border-2 border-stark-black px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs">
              {dept0.tag}
            </span>
            <span class="font-mono text-[11px] sm:text-xs font-bold text-stark-black">
              {dept0.meta}
            </span>
          </div>
        </a>

        <!-- ROW 1, RIGHT CARD (4 COLS): Social Media & PR (System Red) -->
        <a
          href={machinery.link}
          class="paper-lift-alt lg:col-span-4 bg-[#FF3B30] border-2 border-stark-black p-4 sm:p-6 lg:p-8 flex flex-col justify-between shadow-[6px_6px_0px_#000000] group cursor-pointer text-pure-white"
        >
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="bg-pure-white border-2 border-stark-black p-2.5 sm:p-3 shadow-[2px_2px_0px_#000000] inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-stark-black text-[24px] sm:text-[28px]">campaign</span>
              </div>
              <span class="font-mono text-xs sm:text-sm font-bold text-pure-white uppercase tracking-wider">DEP_02</span>
            </div>
            <h3 class="font-display text-[22px] sm:text-[28px] lg:text-[32px] leading-tight font-extrabold uppercase text-pure-white mb-2 sm:mb-3">
              {dept1.name}
            </h3>
            <p class="font-sans text-pure-white/95 text-sm sm:text-base leading-relaxed font-medium">
              {dept1.description}
            </p>
          </div>
          <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t-2 border-pure-white flex items-center justify-between">
            <span class="font-mono font-bold uppercase text-stark-black bg-pure-white border-2 border-stark-black px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs">
              {dept1.tag}
            </span>
            <span class="font-mono text-[11px] sm:text-xs font-bold text-pure-white">
              {dept1.meta}
            </span>
          </div>
        </a>

        <!-- ROW 2, LEFT CARD (4 COLS): Events & Logistics (MAC Yellow) -->
        <a
          href={machinery.link}
          class="paper-lift-alt lg:col-span-4 bg-[#F0C903] border-2 border-stark-black p-4 sm:p-6 lg:p-8 flex flex-col justify-between shadow-[6px_6px_0px_#000000] group cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="bg-stark-black border-2 border-stark-black p-2.5 sm:p-3 shadow-[2px_2px_0px_#000000] inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-pure-white text-[24px] sm:text-[28px]">event_repeat</span>
              </div>
              <span class="font-mono text-xs sm:text-sm font-bold text-stark-black uppercase tracking-wider">DEP_03</span>
            </div>
            <h3 class="font-display text-[22px] sm:text-[28px] lg:text-[32px] leading-tight font-extrabold uppercase text-stark-black mb-2 sm:mb-3">
              {dept2.name}
            </h3>
            <p class="font-sans text-stark-black text-sm sm:text-base leading-relaxed font-medium">
              {dept2.description}
            </p>
          </div>
          <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t-2 border-stark-black flex items-center justify-between">
            <span class="font-mono font-bold uppercase text-stark-black bg-tactical-stone border-2 border-stark-black px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs">
              {dept2.tag}
            </span>
            <span class="font-mono text-[11px] sm:text-xs font-bold text-stark-black">
              {dept2.meta}
            </span>
          </div>
        </a>

        <!-- ROW 2, RIGHT SPLIT CONTAINER (8 COLS): Tech & Creative Sub-Wings -->
        <div class="paper-lift lg:col-span-8 border-2 border-stark-black shadow-[6px_6px_0px_#000000] grid grid-cols-1 md:grid-cols-2 divide-y-2 md:divide-y-0 md:divide-x-2 divide-stark-black bg-pure-white">
          
          <!-- Left Sub-Cell: Technical & Research -->
          <a
            href={machinery.link}
            class="p-4 sm:p-6 lg:p-8 flex flex-col justify-between bg-pure-white hover:bg-surface-container-low transition-colors group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between mb-4 sm:mb-6">
                <div class="bg-tactical-stone border-2 border-stark-black p-2 sm:p-2.5 inline-flex items-center justify-center">
                  <span class="material-symbols-outlined text-stark-black text-[20px] sm:text-[24px]">terminal</span>
                </div>
                <span class="font-mono text-xs font-bold text-on-surface-variant uppercase">
                  {dept3.code}
                </span>
              </div>
              <h3 class="font-display text-xl sm:text-2xl lg:text-[28px] leading-tight font-extrabold uppercase text-stark-black mb-2 sm:mb-3">
                {dept3.name}
              </h3>
              <p class="font-sans text-on-surface text-sm sm:text-[15px] leading-relaxed">
                {dept3.description}
              </p>
            </div>
            <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t-2 border-stark-black flex items-center justify-between">
              <span class="font-mono font-bold uppercase text-stark-black bg-mac-yellow border-2 border-stark-black px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs">
                {dept3.tag}
              </span>
            </div>
          </a>

          <!-- Right Sub-Cell: Creative Studio -->
          <a
            href={machinery.link}
            class="p-4 sm:p-6 lg:p-8 flex flex-col justify-between bg-tactical-stone hover:bg-surface-container transition-colors group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between mb-4 sm:mb-6">
                <div class="bg-pure-white border-2 border-stark-black p-2 sm:p-2.5 inline-flex items-center justify-center">
                  <span class="material-symbols-outlined text-stark-black text-[20px] sm:text-[24px]">palette</span>
                </div>
                <span class="font-mono text-xs font-bold text-on-surface-variant uppercase">
                  {dept4.code}
                </span>
              </div>
              <h3 class="font-display text-xl sm:text-2xl lg:text-[28px] leading-tight font-extrabold uppercase text-stark-black mb-2 sm:mb-3">
                {dept4.name}
              </h3>
              <p class="font-sans text-on-surface text-sm sm:text-[15px] leading-relaxed">
                {dept4.description}
              </p>
            </div>
            <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t-2 border-stark-black flex items-center justify-between">
              <span class="font-mono font-bold uppercase text-stark-black bg-pure-white border-2 border-stark-black px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs">
                {dept4.tag}
              </span>
            </div>
          </a>

        </div>

      </div>
    </section>

    <!-- SECTION CONNECTOR RAIL -->
    <BlueprintDivider tag="CORPORATE_SYNDICATE // PAST_PARTNERS" code="TEL_01.4" accent="black" />

    <!-- =========================================================================
         SECTION 1.4 — "BACKED BY GIANTS" (SPONSOR CONVEYOR BELT)
         ========================================================================= -->
    <section class="w-full my-4 sm:my-6 bg-pure-white border-y-4 border-stark-black shadow-[6px_6px_0px_#000000]">
      <div class="flex flex-col lg:flex-row w-full items-stretch">
        <!-- Left Fixed Header Block -->
        <div class="bg-stark-black text-mac-yellow w-full lg:w-[240px] shrink-0 p-4 sm:p-6 flex items-center justify-center border-b-2 lg:border-b-0 lg:border-r-2 border-stark-black select-none">
          <div class="font-mono text-xs sm:text-base font-bold uppercase tracking-wider text-center flex items-center gap-2">
            {sponsors.header}
          </div>
        </div>

        <!-- 6 Freight-Stamp Cells Grid with Flat Hover Snapping -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 flex-1 divide-y-2 sm:divide-y-0 divide-x-2 divide-stark-black">
          {(sponsors.items || []).filter((s) => s.enabled !== false).map((sponsor) => (
            <a
              href={sponsor.websiteUrl || "#"}
              data-sfx-hover="tick"
              target={sponsor.websiteUrl ? "_blank" : undefined}
              rel={sponsor.websiteUrl ? "noopener noreferrer" : undefined}
              class={`flex flex-col items-center justify-center p-3.5 sm:p-6 min-h-[100px] sm:min-h-[120px] transition-all text-center group cursor-pointer ${
                sponsor.highlighted
                  ? "bg-mac-yellow text-stark-black shadow-[inset_0px_0px_0px_2px_#000000]"
                  : "bg-pure-white text-stark-black hover:bg-mac-yellow hover:shadow-[inset_0px_0px_0px_2px_#000000]"
              }`}
            >
              <div class="font-display text-[15px] sm:text-[18px] lg:text-[22px] font-black uppercase text-stark-black tracking-tight mb-0.5 sm:mb-1 group-hover:scale-105 transition-transform truncate max-w-full">
                {sponsor.name}
              </div>
              <span class={`font-mono text-[10px] sm:text-[12px] font-bold uppercase tracking-wider truncate max-w-full ${
                sponsor.highlighted ? "text-stark-black" : "text-on-surface-variant group-hover:text-stark-black"
              }`}>
                {sponsor.tag}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION CONNECTOR RAIL -->
    <BlueprintDivider tag="DEPLOYMENT_STREAM // LIVE_FEEDS" code="TEL_01.5" accent="red" />

    <!-- =========================================================================
         SECTION 1.5 — "FRESH OFF THE PRESS" (2-COLUMN TEASER SPLIT)
         ========================================================================= -->
    <section class="w-full mb-12 sm:mb-16">
      <div class="w-full flex flex-col sm:flex-row sm:items-center justify-between border-b-4 border-stark-black pb-3 sm:pb-4 mb-6 sm:mb-8 gap-2">
        <h2 class="font-display text-[26px] sm:text-[36px] lg:text-[48px] leading-tight font-black uppercase text-stark-black tracking-[-0.03em]">
          {freshPress.title}
        </h2>
        <div class="font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-on-surface-variant select-none">
          {freshPress.feedTag}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
        
        <!-- LEFT TERMINAL CARD (> FLAGSHIP_SPOTLIGHT) -->
        <div class="lg:col-span-6 bg-pure-white border-4 border-stark-black shadow-[6px_6px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] flex flex-col justify-between">
          <!-- 48px Top Header Bar -->
          <div class="h-10 sm:h-12 bg-stark-black px-3.5 sm:px-4 flex items-center justify-between border-b-2 border-stark-black select-none">
            <span class="font-mono text-xs sm:text-sm font-bold text-mac-yellow uppercase truncate">
              {flagship.headerTitle}
            </span>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="w-2.5 h-2.5 bg-pure-white"></span>
              <span class="w-2.5 h-2.5 bg-mac-yellow"></span>
            </div>
          </div>

          <!-- Poster Box Content Area -->
          <div class="p-4 sm:p-6 lg:p-8 flex flex-col justify-between flex-1">
            <a 
              href={flagship.ctaLink} 
              class="aspect-video w-full bg-stark-black border-2 border-stark-black p-4 sm:p-6 flex flex-col justify-between relative overflow-hidden mb-5 sm:mb-6 group cursor-pointer block"
            >
              <!-- Background Technical Lines -->
              <div 
                class="absolute inset-0 opacity-20 pointer-events-none" 
                style="background-image: repeating-linear-gradient(0deg, #F0C903 0px, #F0C903 1px, transparent 1px, transparent 16px);"
              ></div>
              
              <div class="flex justify-between items-start z-10 gap-2">
                <span class="bg-mac-yellow text-stark-black font-mono text-[10px] sm:text-xs font-bold px-2 py-0.5 border border-stark-black truncate">
                  {flagship.simulationBadge}
                </span>
                <span class="text-mac-yellow font-mono text-[10px] sm:text-xs font-bold shrink-0">
                  {flagship.subBadge}
                </span>
              </div>

              <div class="z-10 mt-auto">
                <h4 class="font-display text-[20px] sm:text-[28px] lg:text-[34px] leading-tight font-black uppercase text-pure-white tracking-tight group-hover:text-mac-yellow transition-colors">
                  {flagship.title}
                </h4>
                <div class="font-mono text-[11px] sm:text-sm font-bold uppercase text-mac-yellow mt-1.5 sm:mt-2">
                  {flagship.subtitle}
                </div>
              </div>
            </a>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
              <a
                href={flagship.ctaLink}
                class="inline-flex items-center justify-center font-mono text-xs sm:text-sm uppercase font-bold bg-mac-yellow text-stark-black border-2 border-stark-black px-5 sm:px-6 py-3 sm:py-3.5 shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-mac-yellow transition-none cursor-pointer text-center"
              >
                {flagship.ctaText}
              </a>
              <span class="font-mono text-xs text-on-surface-variant font-bold">
                {flagship.status}
              </span>
            </div>

            {flagship.rulebookPdfEnabled !== false && flagship.rulebookPdfUrl && flagship.rulebookPdfUrl.trim().length > 0 && flagship.rulebookPdfUrl.trim() !== '#' && (
              <div class="pt-4 border-t-2 border-stark-black mt-4">
                <BrutalFileDownload
                  fileUrl={flagship.rulebookPdfUrl}
                  fileLabel={flagship.rulebookPdfLabel || "DOWNLOAD RULEBOOK [PDF]"}
                  fileType="PDF"
                  variant="bar"
                  enabled={flagship.rulebookPdfEnabled}
                />
              </div>
            )}
          </div>
        </div>

        <!-- RIGHT TERMINAL CARD (> LATEST_INTEL_DISPATCH) -->
        <div class="lg:col-span-6 bg-pure-white border-4 border-stark-black shadow-[6px_6px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] flex flex-col justify-between">
          <!-- 48px Top Header Bar -->
          <div class="h-10 sm:h-12 bg-stark-black px-3.5 sm:px-4 flex items-center justify-between border-b-2 border-stark-black select-none">
            <span class="font-mono text-xs sm:text-sm font-bold text-mac-yellow uppercase truncate">
              {intelFeed.headerTitle}
            </span>
            <span class="font-mono text-[11px] sm:text-xs text-pure-white uppercase font-bold shrink-0 ml-2">
              {intelFeed.feedLabel}
            </span>
          </div>

          <!-- Stacked Newspaper-Clipping Rows -->
          <div class="flex flex-col flex-1 divide-y-2 divide-stark-black">
            {(intelFeed.articles || []).filter((a) => a.enabled !== false).map((article) => (
              <div
                class={`p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 flex-1 transition-colors ${
                  article.highlighted 
                    ? "bg-mac-yellow" 
                    : "bg-pure-white hover:bg-tactical-stone"
                }`}
              >
                <div class="flex flex-col gap-1.5 sm:gap-2">
                  <span class={`font-mono text-[11px] sm:text-xs font-bold uppercase ${
                    article.highlighted ? "text-stark-black" : "text-on-surface-variant"
                  }`}>
                    {article.tag}
                  </span>
                  <h4 class="font-display text-base sm:text-[20px] font-bold text-stark-black leading-snug">
                    {article.title}
                  </h4>
                  <p class={`font-sans text-xs sm:text-sm font-medium ${
                    article.highlighted ? "text-stark-black/85" : "text-on-surface-variant"
                  }`}>
                    {article.description}
                  </p>
                </div>
                <a
                  href={article.link}
                  class={`self-start sm:self-center shrink-0 px-3.5 sm:px-4 py-2 font-mono text-xs font-bold uppercase transition-none cursor-pointer ${
                    article.highlighted
                      ? "bg-stark-black text-mac-yellow border border-stark-black hover:bg-pure-white hover:text-stark-black"
                      : "bg-pure-white text-stark-black border-2 border-stark-black hover:bg-stark-black hover:text-mac-yellow"
                  }`}
                >
                  {intelFeed.readArticleText || "[READ ↗]"}
                </a>
              </div>
            ))}
          </div>

          <!-- Terminal Footer Bar -->
          <div class="p-3.5 sm:p-4 bg-tactical-stone border-t-2 border-stark-black flex items-center justify-between select-none">
            <span class="font-mono text-xs font-bold text-stark-black">
              {intelFeed.footerTotal}
            </span>
            <a
              href={intelFeed.footerLink}
              class="font-mono text-xs font-bold uppercase text-stark-black underline hover:bg-stark-black hover:text-pure-white px-1"
            >
              {intelFeed.footerLinkText}
            </a>
          </div>
        </div>

      </div>
    </section>
    )}

  </div>
</BaseLayout>

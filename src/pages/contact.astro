---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrutalFileDownload from '../components/ui/BrutalFileDownload.astro';
import contactContent from '../content/pages/contact.json';

const {
  breadcrumb,
  encryptionBadge,
  terminalHeader,
  formTitle,
  openProtocolBadge,
  fields,
  packetStatus,
  submitButtonText,
  recipientEmail,
  coordinates,
  sponsorshipDeckPdf,
  sponsorshipHeading,
  sponsorshipTitle,
  sponsorshipSize,
  formFeedback,
  externalChannelsTitle,
  externalLinks,
} = contactContent;
---

<BaseLayout title="CONTACT /// THE MARKETING CLUB (MAC)">
  <!-- SECONDARY BREADCRUMB COMMAND STRIP -->
  <div class="w-full bg-tactical-stone border-b-2 border-stark-black px-4 sm:px-6 lg:px-8 py-2.5 flex flex-col md:flex-row items-start md:items-center justify-between gap-2 select-none">
    <div class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold tracking-wider text-stark-black truncate">
      <span class="inline-block w-2.5 h-2.5 bg-system-red animate-pulse border border-stark-black shrink-0"></span>
      <span class="truncate">{breadcrumb}</span>
    </div>
    <div class="inline-flex items-center gap-1.5 font-mono text-xs font-bold bg-pure-white border border-stark-black px-2.5 py-0.5 text-stark-black shadow-[2px_2px_0px_#000000] shrink-0">
      <span class="material-symbols-outlined text-[14px] text-[#705d00]">lock</span>
      <span>{encryptionBadge}</span>
    </div>
  </div>

  <!-- MAIN VIEWPORT CONTAINER: 2-COLUMN ASYMMETRIC COMMAND GRID -->
  <main class="w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- LEFT COLUMN (6 COLUMNS) — SYSTEM COMMUNICATION TERMINAL -->
      <section class="lg:col-span-6 flex flex-col bg-pure-white border-4 border-stark-black shadow-[8px_8px_0px_#000000] relative">
        <!-- Terminal Title Bar -->
        <header class="h-12 bg-stark-black px-6 flex items-center justify-between border-b-4 border-stark-black select-none">
          <div class="flex items-center gap-2">
            <span class="font-mono text-sm sm:text-base font-bold text-mac-yellow tracking-wider">
              {terminalHeader}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold text-mac-yellow animate-pulse">[&gt;_]</span>
            <span class="w-3 h-3 bg-mac-yellow border border-stark-black inline-block"></span>
          </div>
        </header>

        <!-- Terminal Body -->
        <form
          id="contact-terminal-form"
          class="p-6 md:p-8 flex flex-col gap-6"
          data-recipient={recipientEmail}
          data-transmitting={formFeedback?.transmittingText || "/// TRANSMITTING PAYLOAD... ///"}
          data-confirmed={formFeedback?.confirmedBtnText || "TRANSMISSION CONFIRMED ▷"}
          data-success={formFeedback?.successMessage || "[✓] PAYLOAD TRANSMITTED TO COMMAND CELL. STATUS 200 OK."}
          data-timeout={formFeedback?.timeoutMessage || "[!] DIRECT API RELAY TIMED OUT. TRANSMIT DIRECTLY VIA EMAIL CLIENT:"}
          data-mailto={formFeedback?.mailtoButtonText || "[ ✉ TRANSMIT VIA DEFAULT MAIL CLIENT ]"}
        >
          <!-- Hidden Anti-Spam Honeypot & Config -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_subject" value="New MAC Portal Transmission" />

          <!-- Terminal Sub-Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-stark-black pb-4">
            <span class="font-mono text-xs sm:text-sm font-bold text-stark-black uppercase leading-tight">
              {formTitle}
            </span>
            <span class="font-mono text-[11px] font-bold bg-electric-cyan text-stark-black border-2 border-stark-black px-2 py-0.5 shadow-[2px_2px_0px_#000000] self-start sm:self-auto shrink-0">
              {openProtocolBadge}
            </span>
          </div>

          <!-- Stacked Field Groups -->
          <div class="flex flex-col gap-5">
            <!-- Group 1: Identifier -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-name">
                <span>{fields.identifierLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.identifierType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-name"
                name="name"
                placeholder={fields.identifierPlaceholder}
                required
                type="text"
              />
            </div>

            <!-- Group 2: Network / Email -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-email">
                <span>{fields.networkLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.networkType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-email"
                name="email"
                placeholder={fields.networkPlaceholder}
                required
                type="email"
              />
            </div>

            <!-- Group 3: Protocol / Subject -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-subject">
                <span>{fields.protocolLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.protocolType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-subject"
                name="subject"
                placeholder={fields.protocolPlaceholder}
                required
                type="text"
              />
            </div>

            <!-- Group 4: Payload / Message -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-message">
                <span>{fields.payloadLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.payloadType}</span>
              </label>
              <textarea
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none h-32 resize-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-message"
                name="message"
                placeholder={fields.payloadPlaceholder}
                required
                rows="4"
              ></textarea>
            </div>
          </div>

          <!-- Security Checkpoint / Verification Strip -->
          <div class="bg-tactical-stone border-2 border-stark-black px-3 py-2 flex items-center gap-2 select-none">
            <span class="material-symbols-outlined text-[16px] text-stark-black shrink-0">verified_user</span>
            <span class="font-mono text-[11px] leading-tight font-bold text-stark-black truncate">
              {packetStatus}
            </span>
          </div>

          <!-- Feedback Status Box -->
          <div id="form-status-box" class="hidden"></div>

          <!-- Submit Arcade Button -->
          <button
            class="w-full h-16 bg-mac-yellow border-4 border-stark-black shadow-[6px_6px_0px_#000000] flex items-center justify-center font-black text-xl md:text-2xl uppercase text-stark-black hover:bg-stark-black hover:text-mac-yellow active:translate-x-[6px] active:translate-y-[6px] active:shadow-none transition-all cursor-pointer tracking-wider"
            id="transmit-btn"
            type="submit"
          >
            {submitButtonText}
          </button>
        </form>
      </section>

      <!-- RIGHT COLUMN (6 COLUMNS) — COORDINATES & TELEMETRY CARD -->
      <section class="lg:col-span-6 flex flex-col border-4 border-stark-black shadow-[8px_8px_0px_#000000] bg-pure-white">
        <!-- TOP BLOCK: HEADQUARTERS DOSSIER (YELLOW #F0C903) -->
        <div class="bg-mac-yellow p-6 md:p-8 relative overflow-hidden border-b-4 border-stark-black">
          <!-- Subtle Oversized Watermark -->
          <div class="absolute -right-6 -bottom-8 text-[120px] font-black text-stark-black/10 select-none pointer-events-none tracking-tighter leading-none">
            MAC
          </div>
          <div class="relative z-10 flex flex-col">
            <div class="flex items-center gap-2 text-stark-black mb-1">
              <span class="material-symbols-outlined text-[36px] font-black leading-none">near_me</span>
              <h2 class="font-black text-3xl md:text-4xl uppercase tracking-tight text-stark-black m-0 leading-none">
                {coordinates.title}
              </h2>
            </div>
            <div class="font-mono text-xs font-bold uppercase text-stark-black tracking-wider mb-4">
              {coordinates.subtitle}
            </div>

            <!-- Inset Address Dossier Box -->
            <div 
              class="bg-pure-white border-2 border-stark-black p-5 shadow-[4px_4px_0px_#000000] flex flex-col gap-2 copy-trigger cursor-copy"
              data-copy={`${coordinates.collegeName}, ${coordinates.streetAddress}, ${coordinates.cityPin}`}
              title="CLICK TO COPY PHYSICAL ADDRESS"
            >
              <pre class="font-mono text-xs sm:text-sm font-bold text-stark-black leading-relaxed whitespace-pre-wrap uppercase m-0 pointer-events-none">{coordinates.collegeName}
{coordinates.streetAddress}
{coordinates.cityPin}
/// TEL: {coordinates.phone}
/// MAIL: {coordinates.email}</pre>
              <div class="flex items-center justify-between pointer-events-none">
                <span class="font-mono text-xs font-bold bg-electric-cyan text-stark-black border-2 border-stark-black px-2 py-0.5 shadow-[2px_2px_0px_#000000] inline-block uppercase">
                  {coordinates.status}
                </span>
                <span class="font-mono text-[10px] text-on-surface-variant font-bold uppercase">[ CLICK TO COPY ⧉ ]</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MIDDLE BLOCK: TACTICAL ARCHITECTURAL BLUEPRINT STREET MAP -->
        <div class="relative w-full h-[380px] bg-surface border-b-4 border-stark-black overflow-hidden select-none cursor-reticle" data-reticle>
          <svg class="w-full h-full block" preserveAspectRatio="xMidYMid meet" viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id="tactical-blueprint-subgrid" width="16" height="16" patternUnits="userSpaceOnUse">
                <path d="M 16 0 L 0 0 0 16" fill="none" stroke="#D0C6AB" stroke-width="0.75" opacity="0.5"></path>
              </pattern>
              <pattern id="tactical-blueprint-major" width="64" height="64" patternUnits="userSpaceOnUse">
                <rect width="64" height="64" fill="url(#tactical-blueprint-subgrid)"></rect>
                <path d="M 64 0 L 0 0 0 64" fill="none" stroke="#B8AC8D" stroke-width="1.2" opacity="0.7"></path>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="#FFF8F0"></rect>
            <rect width="100%" height="100%" fill="url(#tactical-blueprint-major)"></rect>
            <rect x="28" y="140" width="130" height="195" fill="#EFE8D8" stroke="#000000" stroke-width="2" stroke-dasharray="4 2"></rect>
            <rect x="35" y="148" width="116" height="85" fill="#FFFFFF" stroke="#000000" stroke-width="1.5"></rect>
            <text x="93" y="182" font-family="JetBrains Mono" font-size="8.5" font-weight="800" fill="#000000" text-anchor="middle">SATYA NIKETAN</text>
            <text x="93" y="195" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#4D4632" text-anchor="middle">[COMMERCIAL HUB &amp; CAFES]</text>
            <rect x="35" y="240" width="116" height="85" fill="#E5DDCB" stroke="#000000" stroke-width="1.5"></rect>
            <text x="93" y="278" font-family="JetBrains Mono" font-size="7.5" font-weight="700" fill="#000000" text-anchor="middle">RESIDENTIAL CLUSTER</text>
            <text x="93" y="290" font-family="JetBrains Mono" font-size="6.5" font-weight="500" fill="#4D4632" text-anchor="middle">[STUDENT SECTOR // PGs]</text>
            <rect x="230" y="135" width="285" height="205" fill="#EFE7D5" stroke="#000000" stroke-width="3"></rect>
            <rect x="240" y="145" width="160" height="75" fill="#FFFFFF" stroke="#000000" stroke-width="2"></rect>
            <text x="248" y="162" font-family="JetBrains Mono" font-size="8.5" font-weight="800" fill="#000000">MAIN ACADEMIC BLOCK</text>
            <text x="248" y="174" font-family="JetBrains Mono" font-size="7" font-weight="600" fill="#4D4632">DEPT OF COMMERCE / AUDITORIUM</text>
            <text x="248" y="186" font-family="JetBrains Mono" font-size="7" font-weight="600" fill="#4D4632">LIBRARY // ICT &amp; ADMIN CELL</text>
            <rect x="240" y="226" width="75" height="36" fill="#FAF2E2" stroke="#000000" stroke-width="1.5"></rect>
            <text x="246" y="244" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#000000">ROCK GARDEN</text>
            <text x="246" y="254" font-family="JetBrains Mono" font-size="6" font-weight="500" fill="#7E7760">[STUDENT FOYER]</text>
            <rect x="322" y="226" width="78" height="36" fill="#FFFFFF" stroke="#000000" stroke-width="1.5"></rect>
            <text x="328" y="244" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#000000">SVC CANTEEN</text>
            <text x="328" y="254" font-family="JetBrains Mono" font-size="6" font-weight="500" fill="#7E7760">[COMMAND REFUEL]</text>
            <rect x="410" y="145" width="95" height="117" fill="#E4DBC7" stroke="#000000" stroke-width="1.5"></rect>
            <circle cx="457" cy="203" r="32" fill="none" stroke="#000000" stroke-width="1.2" stroke-dasharray="3 3"></circle>
            <text x="457" y="200" font-family="JetBrains Mono" font-size="8" font-weight="800" fill="#000000" text-anchor="middle">CRICKET GROUND</text>
            <text x="457" y="211" font-family="JetBrains Mono" font-size="6.5" font-weight="600" fill="#4D4632" text-anchor="middle">&amp; SPORTS COMPLEX</text>
            <rect x="240" y="270" width="265" height="60" fill="none" stroke="#7E7760" stroke-width="1" stroke-dasharray="2 2"></rect>
            <text x="372" y="304" font-family="JetBrains Mono" font-size="7.5" font-weight="700" fill="#7E7760" text-anchor="middle">SRI VENKATESWARA PERIMETER CAMPUS GROUNDS</text>
            <rect x="230" y="350" width="125" height="30" fill="#E5DDD0" stroke="#000000" stroke-width="1.5"></rect>
            <text x="236" y="365" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#000000">RAM LAL ANAND COLL.</text>
            <rect x="365" y="350" width="125" height="30" fill="#E5DDD0" stroke="#000000" stroke-width="1.5"></rect>
            <text x="371" y="365" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#000000">ARYABHATTA COLLEGE</text>
            <path d="M-20,68 L660,118" fill="none" stroke="#000000" stroke-width="30" stroke-linecap="square"></path>
            <path d="M-20,68 L660,118" fill="none" stroke="#F0C903" stroke-width="22"></path>
            <path d="M-20,68 L660,118" fill="none" stroke="#000000" stroke-width="2" stroke-dasharray="10 10"></path>
            <path d="M 195,85 L 195,385" fill="none" stroke="#000000" stroke-width="32" stroke-linecap="square"></path>
            <path d="M 195,85 L 195,385" fill="none" stroke="#FFFFFF" stroke-width="24"></path>
            <path d="M 195,85 L 195,385" fill="none" stroke="#000000" stroke-width="2" stroke-dasharray="8 8"></path>
            <path d="M 195,150 L 230,150" fill="none" stroke="#000000" stroke-width="8"></path>
            <path d="M 195,150 L 230,150" fill="none" stroke="#F0C903" stroke-width="4"></path>
            <path d="M 195,185 L 165,185" fill="none" stroke="#000000" stroke-width="8"></path>
            <path d="M 195,185 L 165,185" fill="none" stroke="#FFFFFF" stroke-width="4"></path>
            <path d="M-20,40 L660,90" fill="none" stroke="#ba1a1a" stroke-width="4.5" stroke-dasharray="10 4"></path>
            <circle cx="240" cy="59" r="6" fill="#ba1a1a" stroke="#000000" stroke-width="2"></circle>
            <rect x="252" y="46" width="215" height="20" fill="#000000" stroke="#ba1a1a" stroke-width="1.5"></rect>
            <text x="258" y="59" font-family="JetBrains Mono" font-size="7.5" font-weight="800" fill="#FFFFFF">DURGABAI DESHMUKH SOUTH CAMPUS ◉</text>
            <path d="M 240,65 L 240,115 L 195,115" fill="none" stroke="#ba1a1a" stroke-width="3" stroke-dasharray="3 3"></path>
            <rect x="225" y="92" width="74" height="14" fill="#FFFFFF" stroke="#ba1a1a" stroke-width="1"></rect>
            <text x="228" y="102" font-family="JetBrains Mono" font-size="6.5" font-weight="700" fill="#ba1a1a">FOOT OVER BRIDGE</text>
            <text x="40" y="88" font-family="JetBrains Mono" font-size="9" font-weight="800" fill="#000000" transform="rotate(4.2, 40, 88)">RING ROAD / MAHATMA GANDHI MARG ⇄</text>
            <text x="200" y="255" font-family="JetBrains Mono" font-size="9" font-weight="800" fill="#000000" transform="rotate(90, 200, 255)">BENITO JUAREZ MARG ⇄</text>
            <text x="500" y="78" font-family="JetBrains Mono" font-size="7.5" font-weight="800" fill="#000000">▲ TO DHAULA KUAN FLYOVER</text>
            <text x="500" y="88" font-family="JetBrains Mono" font-size="6.5" font-weight="700" fill="#4D4632">AIRPORT EXPRESS METRO INTERCHANGE</text>
            <text x="195" y="376" font-family="JetBrains Mono" font-size="7" font-weight="800" fill="#000000" text-anchor="middle">▼ TOWARDS SAN MARTIN MARG / MOTI BAGH</text>
            <rect x="545" y="12" width="85" height="42" fill="#000000" stroke="#F0C903" stroke-width="1.5"></rect>
            <text x="587" y="28" font-family="JetBrains Mono" font-size="14" font-weight="900" fill="#F0C903" text-anchor="middle">▲ N</text>
            <text x="587" y="42" font-family="JetBrains Mono" font-size="7" font-weight="700" fill="#FFFFFF" text-anchor="middle">AZIMUTH 000°</text>
            <rect x="12" y="12" width="240" height="32" fill="#FFFFFF" stroke="#000000" stroke-width="1.5"></rect>
            <text x="18" y="25" font-family="JetBrains Mono" font-size="7.5" font-weight="800" fill="#000000">SECTOR_LAT: 28.5878° N // LON: 77.1666° E</text>
            <text x="18" y="36" font-family="JetBrains Mono" font-size="6.5" font-weight="700" fill="#4D4632">ELEVATION: 231M // GRID REF: DL-SOUTH-06</text>
            <rect x="12" y="348" width="120" height="20" fill="#FFFFFF" stroke="#000000" stroke-width="1.5"></rect>
            <line x1="18" y1="360" x2="108" y2="360" stroke="#000000" stroke-width="2"></line>
            <line x1="18" y1="356" x2="18" y2="364" stroke="#000000" stroke-width="2"></line>
            <line x1="63" y1="357" x2="63" y2="363" stroke="#000000" stroke-width="1.5"></line>
            <line x1="108" y1="356" x2="108" y2="364" stroke="#000000" stroke-width="2"></line>
            <text x="18" y="353" font-family="JetBrains Mono" font-size="6" font-weight="700" fill="#000000">0</text>
            <text x="55" y="353" font-family="JetBrains Mono" font-size="6" font-weight="700" fill="#000000">100m</text>
            <text x="98" y="353" font-family="JetBrains Mono" font-size="6" font-weight="700" fill="#000000">200m</text>
          </svg>

          <!-- Radar Pulse Pinpoint Marker -->
          <div class="absolute left-[47%] top-[45%] -translate-x-1/2 -translate-y-1/2 flex flex-col items-center pointer-events-none z-10">
            <div class="relative flex items-center justify-center">
              <span class="w-10 h-10 border-2 border-system-red animate-ping absolute bg-system-red/20"></span>
              <div class="w-7 h-7 bg-stark-black border-2 border-mac-yellow flex items-center justify-center shadow-[3px_3px_0px_#000000]">
                <span class="material-symbols-outlined text-[16px] text-mac-yellow font-black">adjust</span>
              </div>
            </div>
            <div class="mt-1.5 bg-stark-black border-2 border-mac-yellow px-2.5 py-1 shadow-[4px_4px_0px_#000000] flex items-center gap-1.5">
              <span class="w-2 h-2 bg-mac-yellow animate-pulse inline-block"></span>
              <span class="font-mono text-[10px] font-black text-mac-yellow tracking-wider whitespace-nowrap">
                [⌖ SRI VENKATESWARA COLLEGE // VENKY // MAC HQ]
              </span>
            </div>
          </div>

          <!-- Bottom Right: View Google Map Button -->
          <div class="absolute bottom-3 right-3 z-20">
            <a
              class="bg-pure-white text-stark-black font-mono text-xs font-bold border-2 border-stark-black px-3.5 py-1.5 shadow-[3px_3px_0px_#000000] hover:bg-stark-black hover:text-mac-yellow active:translate-x-0.5 active:translate-y-0.5 active:shadow-none inline-flex items-center gap-1.5 transition-all"
              href={coordinates.googleMapsUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="material-symbols-outlined text-[14px]">map</span>
              <span>{coordinates.viewMapText}</span>
            </a>
          </div>
        </div>

        <!-- BOTTOM BLOCK: EXTERNAL TELEMETRY & CHANNELS -->
        <div class="p-6 bg-pure-white flex flex-col gap-5">
          <div>
            <div class="font-mono text-xs font-bold uppercase text-stark-black mb-3 select-none">
              {externalChannelsTitle}
            </div>
            <div class="flex flex-col gap-2">
              {externalLinks.map((link) => (
                <a
                  class={`border-2 border-stark-black p-3.5 flex items-center justify-between font-mono text-xs sm:text-sm font-bold shadow-[2px_2px_0px_#000000] transition-all ${
                    link.active
                      ? 'bg-mac-yellow text-stark-black shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-mac-yellow'
                      : 'bg-pure-white text-stark-black hover:bg-mac-yellow hover:shadow-[4px_4px_0px_#000000]'
                  }`}
                  href={link.url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span class="flex items-center gap-2 truncate pr-2">
                    <span class={`w-2 h-2 ${link.active ? 'bg-stark-black' : 'bg-blueprint-grid'} inline-block shrink-0`}></span>
                    <span class="truncate">{link.label}</span>
                  </span>
                  <span class="shrink-0">{link.actionText}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- CORPORATE SPONSORSHIP DECK DOWNLOAD -->
          {sponsorshipDeckPdf && (
            <div class="pt-4 border-t-2 border-stark-black">
              <div class="font-mono text-xs font-bold uppercase text-stark-black mb-2 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">file_present</span>
                <span>{sponsorshipHeading || "PARTNERSHIP & SPONSORSHIP DOSSIER:"}</span>
              </div>
              <BrutalFileDownload
                title={sponsorshipTitle || 'MAC_OFFICIAL_SPONSORSHIP_DECK_2027.PDF'}
                fileUrl={sponsorshipDeckPdf}
                fileSize={sponsorshipSize || '2.1 MB'}
                fileFormat="PDF"
              />

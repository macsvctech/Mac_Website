---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrutalFileDownload from '../components/ui/BrutalFileDownload.astro';
import contactContent from '../content/pages/contact.json';

const {
  breadcrumb,
  encryptionBadge,
  terminalHeader,
  formTitle,
  openProtocolBadge,
  fields,
  packetStatus,
  submitButtonText,
  recipientEmail,
  coordinates,
  sponsorshipDeckPdf,
  sponsorshipHeading,
  sponsorshipTitle,
  sponsorshipSize,
  formFeedback,
  externalChannelsTitle,
  externalLinks,
} = contactContent;
---

<BaseLayout title="CONTACT /// THE MARKETING CLUB (MAC)">
  <!-- SECONDARY BREADCRUMB COMMAND STRIP -->
  <div class="w-full bg-tactical-stone border-b-2 border-stark-black px-3.5 sm:px-6 lg:px-8 py-2.5 flex flex-col md:flex-row items-start md:items-center justify-between gap-2 select-none">
    <div class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold tracking-wider text-stark-black min-w-0 truncate">
      <span class="inline-block w-2.5 h-2.5 bg-system-red animate-pulse border border-stark-black shrink-0"></span>
      <span class="truncate">{breadcrumb}</span>
    </div>
    <div class="inline-flex items-center gap-1.5 font-mono text-xs font-bold bg-pure-white border border-stark-black px-2.5 py-0.5 text-stark-black shadow-[2px_2px_0px_#000000] shrink-0">
      <span class="material-symbols-outlined text-[14px] text-[#705d00]">lock</span>
      <span>{encryptionBadge}</span>
    </div>
  </div>

  <!-- MAIN VIEWPORT CONTAINER: 2-COLUMN ASYMMETRIC COMMAND GRID -->
  <main class="w-full max-w-[1280px] mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
      <!-- LEFT COLUMN (6 COLUMNS) — SYSTEM COMMUNICATION TERMINAL -->
      <section class="lg:col-span-6 flex flex-col bg-pure-white border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] relative">
        <!-- Terminal Title Bar -->
        <header class="min-h-12 h-auto py-2.5 px-4 sm:px-6 flex items-center justify-between border-b-4 border-stark-black select-none gap-2">
          <div class="flex items-center gap-2 min-w-0 truncate">
            <span class="font-mono text-xs sm:text-base font-bold text-mac-yellow tracking-wider truncate">
              {terminalHeader}
            </span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="font-mono text-xs font-bold text-mac-yellow animate-pulse">[&gt;_]</span>
            <span class="w-3 h-3 bg-mac-yellow border border-stark-black inline-block"></span>
          </div>
        </header>

        <!-- Terminal Body -->
        <form
          id="contact-terminal-form"
          class="p-4 sm:p-6 md:p-8 flex flex-col gap-5 sm:gap-6"
          data-recipient={recipientEmail}
          data-transmitting={formFeedback?.transmittingText || "/// TRANSMITTING PAYLOAD... ///"}
          data-confirmed={formFeedback?.confirmedBtnText || "TRANSMISSION CONFIRMED ▷"}
          data-success={formFeedback?.successMessage || "[✓] PAYLOAD TRANSMITTED TO COMMAND CELL. STATUS 200 OK."}
          data-timeout={formFeedback?.timeoutMessage || "[!] DIRECT API RELAY TIMED OUT. TRANSMIT DIRECTLY VIA EMAIL CLIENT:"}
          data-mailto={formFeedback?.mailtoButtonText || "[ ✉ TRANSMIT VIA DEFAULT MAIL CLIENT ]"}
        >
          <!-- Hidden Anti-Spam Honeypot & Config -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_subject" value="New MAC Portal Transmission" />

          <!-- Terminal Sub-Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-stark-black pb-4">
            <span class="font-mono text-xs sm:text-sm font-bold text-stark-black uppercase leading-tight">
              {formTitle}
            </span>
            <span class="font-mono text-[11px] font-bold bg-electric-cyan text-stark-black border-2 border-stark-black px-2 py-0.5 shadow-[2px_2px_0px_#000000] self-start sm:self-auto shrink-0">
              {openProtocolBadge}
            </span>
          </div>

          <!-- Stacked Field Groups -->
          <div class="flex flex-col gap-5">
            <!-- Group 1: Identifier -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-name">
                <span>{fields.identifierLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.identifierType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-name"
                name="name"
                placeholder={fields.identifierPlaceholder}
                required
                type="text"
              />
            </div>

            <!-- Group 2: Network / Email -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-email">
                <span>{fields.networkLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.networkType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-email"
                name="email"
                placeholder={fields.networkPlaceholder}
                required
                type="email"
              />
            </div>

            <!-- Group 3: Protocol / Subject -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-subject">
                <span>{fields.protocolLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.protocolType}</span>
              </label>
              <input
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-subject"
                name="subject"
                placeholder={fields.protocolPlaceholder}
                required
                type="text"
              />
            </div>

            <!-- Group 4: Payload / Message -->
            <div class="flex flex-col gap-1.5">
              <label class="font-mono text-xs font-bold text-stark-black uppercase flex items-center justify-between" for="terminal-message">
                <span>{fields.payloadLabel}</span>
                <span class="font-mono text-[11px] text-on-surface-variant font-medium">{fields.payloadType}</span>
              </label>
              <textarea
                class="w-full bg-pure-white border-2 border-stark-black p-3.5 font-mono text-xs sm:text-sm text-stark-black placeholder:text-gray-400 focus:outline-none h-32 resize-none focus:bg-surface focus:border-4 focus:shadow-[4px_4px_0px_#000000] transition-all"
                id="terminal-message"
                name="message"
                placeholder={fields.payloadPlaceholder}
                required
                rows="4"
              ></textarea>
            </div>
          </div>

          <!-- Security Checkpoint / Verification Strip -->
          <div class="bg-tactical-stone border-2 border-stark-black px-3 py-2 flex items-center gap-2 select-none">
            <span class="material-symbols-outlined text-[16px] text-stark-black shrink-0">verified_user</span>
            <span class="font-mono text-[11px] leading-tight font-bold text-stark-black truncate">
              {packetStatus}
            </span>
          </div>

          <!-- Feedback Status Box -->
          <div id="form-status-box" class="hidden"></div>

          <!-- Submit Arcade Button -->
          <button
            class="w-full h-14 sm:h-16 bg-mac-yellow border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[6px_6px_0px_#000000] flex items-center justify-center font-black text-lg sm:text-xl md:text-2xl uppercase text-stark-black hover:bg-stark-black hover:text-mac-yellow active:translate-x-[4px] active:translate-y-[4px] sm:active:translate-x-[6px] sm:active:translate-y-[6px] active:shadow-none transition-all cursor-pointer tracking-wider"
            id="transmit-btn"
            type="submit"
          >
            {submitButtonText}
          </button>
        </form>
      </section>

      <!-- RIGHT COLUMN (6 COLUMNS) — COORDINATES & TELEMETRY CARD -->
      <section class="lg:col-span-6 flex flex-col border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] bg-pure-white">
        <!-- TOP BLOCK: HEADQUARTERS DOSSIER (YELLOW #F0C903) -->
        <div class="bg-mac-yellow p-4 sm:p-6 md:p-8 relative overflow-hidden border-b-4 border-stark-black">
          <!-- Subtle Oversized Watermark -->
          <div class="absolute -right-6 -bottom-8 text-[100px] sm:text-[120px] font-black text-stark-black/10 select-none pointer-events-none tracking-tighter leading-none">
            MAC
          </div>
          <div class="relative z-10 flex flex-col">
            <div class="flex items-center gap-2 text-stark-black mb-1">
              <span class="material-symbols-outlined text-[28px] sm:text-[36px] font-black leading-none">near_me</span>
              <h2 class="font-black text-2xl sm:text-3xl md:text-4xl uppercase tracking-tight text-stark-black m-0 leading-none">
                {coordinates.title}
              </h2>
            </div>
            <div class="font-mono text-[11px] sm:text-xs font-bold uppercase text-stark-black tracking-wider mb-4">
              {coordinates.subtitle}
            </div>

            <!-- Inset Address Dossier Box -->
            <div 
              class="bg-pure-white border-2 border-stark-black p-3.5 sm:p-5 shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] flex flex-col gap-2 copy-trigger cursor-copy"
              data-copy={`${coordinates.collegeName}, ${coordinates.streetAddress}, ${coordinates.cityPin}`}
              title="CLICK TO COPY PHYSICAL ADDRESS"
            >
              <pre class="font-mono text-[11px] sm:text-xs md:text-sm font-bold text-stark-black leading-relaxed whitespace-pre-wrap uppercase m-0 pointer-events-none break-words">{coordinates.collegeName}
{coordinates.streetAddress}
{coordinates.cityPin}
/// TEL: {coordinates.phone}
/// MAIL: {coordinates.email}</pre>
              <div class="flex items-center justify-between pointer-events-none pt-1 border-t border-stark-black/20">
                <span class="font-mono text-[10px] sm:text-xs font-bold bg-electric-cyan text-stark-black border-2 border-stark-black px-2 py-0.5 shadow-[2px_2px_0px_#000000] inline-block uppercase">
                  {coordinates.status}
                </span>
                <span class="font-mono text-[9px] sm:text-[10px] text-on-surface-variant font-bold uppercase">[ CLICK TO COPY ⧉ ]</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MIDDLE BLOCK: TACTICAL ARCHITECTURAL BLUEPRINT STREET MAP -->
        <div class="relative w-full h-[280px] sm:h-[380px] bg-surface border-b-4 border-stark-black overflow-hidden select-none cursor-reticle" data-reticle>
          <svg class="w-full h-full block" preserveAspectRatio="xMidYMid meet" viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Blueprint Grids -->
    <pattern id="tactical-blueprint-subgrid" width="16" height="16" patternUnits="userSpaceOnUse">
      <path d="M 16 0 L 0 0 0 16" fill="none" stroke="#D0C6AB" stroke-width="0.75" opacity="0.45" />
    </pattern>
    <pattern id="tactical-blueprint-major" width="64" height="64" patternUnits="userSpaceOnUse">
      <rect width="64" height="64" fill="url(#tactical-blueprint-subgrid)" />
      <path d="M 64 0 L 0 0 0 64" fill="none" stroke="#B8AC8D" stroke-width="1.2" opacity="0.65" />
    </pattern>
    <pattern id="sports-turf-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="6" stroke="#60864E" stroke-width="0.75" opacity="0.35" />
    </pattern>
  </defs>

  <!-- 1. BASE BACKGROUND & ARCHITECTURAL BLUEPRINT GRID -->
  <rect width="100%" height="100%" fill="#FFF8F0" />
  <rect width="100%" height="100%" fill="url(#tactical-blueprint-major)" />

  <!-- 2. CAMPUS ZONE GROUND POLYGON (Sri Venkateswara College Campus Boundary) -->
  <path d="M 50,335 L 65,220 L 95,120 L 190,40 L 480,20 L 525,85 L 375,188 L 295,225 C 255,245 220,285 200,350 Z" 
        fill="#FAF2E2" stroke="#000000" stroke-width="1.5" stroke-dasharray="4 3" />
  
  <text x="75" y="352" font-family="'JetBrains Mono', monospace" font-size="6" font-weight="700" fill="#7E7760">/// CAMPUS WEST PERIMETER</text>
  <text x="320" y="32" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="700" fill="#7E7760" text-anchor="middle">SRI VENKATESWARA COLLEGE PROPERTY BOUNDARY // EST. 1961</text>

  <!-- 3. SATYA NIKETAN URBAN ZONE BASE (South-East across Benito Juarez Marg) -->
  <path d="M 235,385 C 250,320 290,265 355,232 L 645,125 L 645,385 Z" fill="#EFE8D8" stroke="#000000" stroke-width="2" />

  <!-- 4. SATYA NIKETAN STREET NETWORK & BUILDING PARCELS -->
  <!-- 4.1 Street corridors (White with Dashed Centerlines) -->
  
  <!-- 5th Lane -->
  <path d="M 265,348 L 335,322" stroke="#FFFFFF" stroke-width="11" stroke-linecap="square" />
  <path d="M 265,348 L 335,322" stroke="#000000" stroke-width="1" stroke-dasharray="3 2" />

  <!-- 4th Lane (The Core Cafe Row) -->
  <path d="M 300,296 L 565,198" stroke="#FFFFFF" stroke-width="14" stroke-linecap="square" />
  <path d="M 300,296 L 565,198" stroke="#000000" stroke-width="1.2" stroke-dasharray="4 2" />

  <!-- 3rd Lane -->
  <path d="M 345,342 L 620,242" stroke="#FFFFFF" stroke-width="13" stroke-linecap="square" />
  <path d="M 345,342 L 620,242" stroke="#000000" stroke-width="1" stroke-dasharray="4 2" />

  <!-- 2nd Lane -->
  <path d="M 385,385 L 640,290" stroke="#FFFFFF" stroke-width="12" stroke-linecap="square" />
  <path d="M 385,385 L 640,290" stroke="#000000" stroke-width="1" stroke-dasharray="3 2" />

  <!-- Nanakpura Road (SE direction) -->
  <path d="M 326,242 L 388,385" stroke="#FFFFFF" stroke-width="13" stroke-linecap="square" />
  <path d="M 326,242 L 388,385" stroke="#000000" stroke-width="1" stroke-dasharray="3 2" />

  <!-- B Street -->
  <path d="M 370,270 L 412,385" stroke="#FFFFFF" stroke-width="9" stroke-linecap="square" />
  <path d="M 370,270 L 412,385" stroke="#000000" stroke-width="0.8" stroke-dasharray="2 2" />

  <!-- Satya Niketan Road (Main Spine) -->
  <path d="M 412,210 L 482,385" stroke="#FFFFFF" stroke-width="15" stroke-linecap="square" />
  <path d="M 412,210 L 482,385" stroke="#000000" stroke-width="1.2" stroke-dasharray="4 2" />

  <!-- Street A -->
  <path d="M 488,182 L 565,385" stroke="#FFFFFF" stroke-width="12" stroke-linecap="square" />
  <path d="M 488,182 L 565,385" stroke="#000000" stroke-width="1" stroke-dasharray="3 2" />

  <!-- 4.2 Satya Niketan Building Blocks / Urban Clusters -->
  <!-- Block cluster 1: Between Nanakpura Rd & 5th Ln / 4th Ln -->
  <polygon points="275,340 320,323 313,307 282,319" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="280,378 335,357 330,344 285,361" fill="#E5DDD0" stroke="#000000" stroke-width="1.2" />

  <!-- Block cluster 2: Between Nanakpura Rd, B St & 4th Ln / 3rd Ln -->
  <polygon points="334,292 365,280 357,260 327,272" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="340,334 371,322 361,298 330,310" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="353,365 385,353 376,330 345,342" fill="#E5DDD0" stroke="#000000" stroke-width="1.2" />

  <!-- Block cluster 3: Between B St, Satya Niketan Rd & 4th Ln / 3rd Ln -->
  <polygon points="377,276 405,265 397,245 370,256" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="383,318 412,307 403,283 374,294" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="397,351 426,340 417,316 388,327" fill="#FAF2E2" stroke="#000000" stroke-width="1.2" />

  <!-- Block cluster 4: Between Satya Niketan Rd & Street A (Core Cafe Hub) -->
  <polygon points="424,258 480,237 472,217 416,238" fill="#FFFFFF" stroke="#000000" stroke-width="1.8" />
  <line x1="438" y1="253" x2="430" y2="233" stroke="#000000" stroke-width="1" />
  <line x1="452" y1="248" x2="444" y2="228" stroke="#000000" stroke-width="1" />
  <line x1="466" y1="243" x2="458" y2="223" stroke="#000000" stroke-width="1" />

  <polygon points="432,300 490,278 482,254 424,276" fill="#FFFFFF" stroke="#000000" stroke-width="1.8" />
  <line x1="446" y1="295" x2="438" y2="271" stroke="#000000" stroke-width="1" />
  <line x1="461" y1="289" x2="453" y2="265" stroke="#000000" stroke-width="1" />
  <line x1="475" y1="284" x2="467" y2="260" stroke="#000000" stroke-width="1" />

  <polygon points="445,334 504,312 495,288 436,310" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="458,368 518,346 510,322 450,344" fill="#E5DDD0" stroke="#000000" stroke-width="1.2" />

  <!-- Block cluster 5: East of Street A -->
  <polygon points="498,230 554,209 546,189 490,210" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="508,272 568,249 558,226 498,248" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="522,314 582,291 573,266 513,289" fill="#FAF2E2" stroke="#000000" stroke-width="1.5" />
  <polygon points="536,356 596,333 587,308 527,331" fill="#E5DDD0" stroke="#000000" stroke-width="1.2" />

  <!-- Block cluster 6: Far East Blocks (towards Ring Road junction) -->
  <polygon points="572,202 630,180 622,160 564,182" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
  <polygon points="584,244 642,222 633,198 575,220" fill="#FAF2E2" stroke="#000000" stroke-width="1.5" />
  <polygon points="598,286 645,268 645,240 589,262" fill="#E5DDD0" stroke="#000000" stroke-width="1.2" />

  <!-- Satya Niketan Header Badge -->
  <rect x="424" y="244" width="76" height="14" fill="#000000" stroke="#F0C903" stroke-width="1" />
  <text x="462" y="254" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="900" fill="#F0C903" text-anchor="middle">SATYA NIKETAN</text>
  <text x="462" y="264" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#4D4632" text-anchor="middle">[COMMERCIAL &amp; CAFE SECTOR]</text>

  <!-- Angled Street Labels -->
  <text x="315" y="291" font-family="'JetBrains Mono', monospace" font-size="6" font-weight="800" fill="#000000" transform="rotate(-20.3, 315, 291)">4TH LN // CAFE ROW ➔</text>
  <text x="365" y="337" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#4D4632" transform="rotate(-20.3, 365, 337)">3RD LN</text>
  <text x="405" y="379" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#4D4632" transform="rotate(-20.3, 405, 379)">2ND LN</text>
  <text x="272" y="343" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#4D4632" transform="rotate(-20.3, 272, 343)">5TH LN</text>

  <text x="345" y="280" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#000000" transform="rotate(66, 345, 280)">NANAKPURA RD ➔</text>
  <text x="382" y="295" font-family="'JetBrains Mono', monospace" font-size="5" font-weight="700" fill="#7E7760" transform="rotate(66, 382, 295)">B ST</text>
  <text x="432" y="295" font-family="'JetBrains Mono', monospace" font-size="6" font-weight="800" fill="#000000" transform="rotate(66, 432, 295)">SATYA NIKETAN RD ➔</text>
  <text x="508" y="275" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#000000" transform="rotate(66, 508, 275)">STREET A ➔</text>

  <!-- Green landmark dot on 3rd Ln / Street A (matching screenshot) -->
  <circle cx="538" cy="272" r="5" fill="#34A853" stroke="#000000" stroke-width="1.5" />
  <circle cx="538" cy="272" r="1.5" fill="#FFFFFF" />

  <!-- 5. BENITO JUAREZ MARG (The Main Diagonal Arterial Road) -->
  <!-- Outer road casing -->
  <path d="M 205,385 C 220,315 260,255 330,222 L 650,105" 
        fill="none" stroke="#000000" stroke-width="32" stroke-linecap="square" />
  <!-- Asphalt road bed -->
  <path d="M 205,385 C 220,315 260,255 330,222 L 650,105" 
        fill="none" stroke="#FFFFFF" stroke-width="26" />
  <!-- Center Median / Dual Carriageway Divider -->
  <path d="M 205,385 C 220,315 260,255 330,222 L 650,105" 
        fill="none" stroke="#F0C903" stroke-width="4" />
  <path d="M 205,385 C 220,315 260,255 330,222 L 650,105" 
        fill="none" stroke="#000000" stroke-width="1.5" stroke-dasharray="6 4" />

  <!-- Road Traffic Flow Arrows & Street Labels -->
  <g transform="rotate(-20.3, 490, 162)">
    <text x="490" y="157" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="900" fill="#000000" text-anchor="middle" letter-spacing="0.08em">
      BENITO JUAREZ MARG ⇄
    </text>
    <text x="490" y="167" font-family="'JetBrains Mono', monospace" font-size="6" font-weight="700" fill="#4D4632" text-anchor="middle">
      [PRIMARY ARTERIAL CORRIDOR // DUAL CARRIAGEWAY]
    </text>
    <path d="M 585,160 L 595,160 M 591,157 L 595,160 L 591,163" stroke="#000000" stroke-width="1.5" fill="none" />
    <path d="M 385,160 L 375,160 M 379,157 L 375,160 L 379,163" stroke="#000000" stroke-width="1.5" fill="none" />
  </g>

  <!-- Curving Hindi / English Road label at bottom-left -->
  <text x="175" y="340" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="800" fill="#000000" transform="rotate(-68, 175, 340)">
    बेनिटो जुआरेज मार्ग ⇄
  </text>
  <text x="183" y="340" font-family="'JetBrains Mono', monospace" font-size="5.5" font-weight="700" fill="#7E7760" transform="rotate(-68, 175, 340)">
    ▼ TOWARDS MOTI BAGH // SAN MARTIN MARG
  </text>

  <!-- 6. BUS STOPS ALONG BENITO JUAREZ MARG -->
  <g transform="translate(262, 230)">
    <rect x="-7" y="-7" width="14" height="14" fill="#F0C903" stroke="#000000" stroke-width="1.5" />

<!-- CLIENT-SIDE SCRIPT: FORM SUBMISSION TO FORMSUBMIT AJAX -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-terminal-form');
    const transmitBtn = document.getElementById('transmit-btn');
    const statusBox = document.getElementById('form-status-box');

    if (!form || !transmitBtn || !statusBox) return;

    const recipient = form.getAttribute('data-recipient') || 'mac.svc2016@gmail.com';
    const transmittingTxt = form.getAttribute('data-transmitting') || '/// TRANSMITTING PAYLOAD... ///';
    const confirmedTxt = form.getAttribute('data-confirmed') || 'TRANSMISSION CONFIRMED ▷';
    const successMsg = form.getAttribute('data-success') || '[✓] PAYLOAD TRANSMITTED TO COMMAND CELL. STATUS 200 OK.';
    const timeoutMsg = form.getAttribute('data-timeout') || '[!] DIRECT API RELAY TIMED OUT. TRANSMIT DIRECTLY VIA EMAIL CLIENT:';
    const mailtoBtnTxt = form.getAttribute('data-mailto') || '[ ✉ TRANSMIT VIA DEFAULT MAIL CLIENT ]';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot spam defense
      const honeyField = form.elements['_honey'];
      if (honeyField && honeyField.value) {
        return;
      }

      const originalBtnText = transmitBtn.innerHTML;
      transmitBtn.disabled = true;
      transmitBtn.innerHTML = transmittingTxt;
      transmitBtn.classList.add('bg-tactical-stone');

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${recipient}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          transmitBtn.innerHTML = confirmedTxt;
          transmitBtn.classList.remove('bg-tactical-stone', 'bg-mac-yellow');
          transmitBtn.classList.add('bg-electric-cyan');

          statusBox.innerHTML = `
            <div class="p-3 bg-electric-cyan border-2 border-stark-black font-mono text-xs font-bold text-stark-black shadow-[3px_3px_0px_#000000]">
              ${successMsg}
            </div>
          `;
          statusBox.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error('Server returned error status');
        }
      } catch (err) {
        console.warn('Direct relay encountered an issue, offering mailto fallback:', err);
        transmitBtn.innerHTML = '/// RELAY BUSY — FALLBACK READY ///';
        transmitBtn.classList.remove('bg-tactical-stone', 'bg-mac-yellow');
        transmitBtn.classList.add('bg-mac-yellow');

        const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(data.subject || 'Portal Transmission')}&body=${encodeURIComponent(`NAME: ${data.name}\nEMAIL: ${data.email}\n\n${data.message}`)}`;

        statusBox.innerHTML = `
          <div class="p-3 bg-tactical-stone border-2 border-stark-black font-mono text-xs font-bold text-stark-black shadow-[3px_3px_0px_#000000] flex flex-col gap-2">
            <span>${timeoutMsg}</span>
            <a href="${mailtoUrl}" class="inline-block py-2 px-3 bg-mac-yellow border border-stark-black text-center text-stark-black hover:bg-stark-black hover:text-mac-yellow transition-all">
              ${mailtoBtnTxt}
            </a>
          </div>
        `;
        statusBox.classList.remove('hidden');
        transmitBtn.disabled = false;
      }
    });
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrutalMedia from '../components/ui/BrutalMedia.astro';
import BlueprintDivider from '../components/ui/BlueprintDivider.astro';
import { getCollection } from 'astro:content';
import testimonialsPageData from '../content/pages/testimonials.json';

const allTestimonials = await getCollection('testimonials');
const sortedTestimonials = allTestimonials.filter(t => t.data.enabled !== false).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const { 
  breadcrumb, 
  securityTier, 
  header, 
  stats, 
  dossierOpenText = "[ READ FULL DOSSIER + ]", 
  dossierCloseText = "[ CLOSE DOSSIER - ]", 
  linkedinText = "[ LINKEDIN ↗ ]", 
  backToBlueprintText = "[ <- BACK TO BLUEPRINT ]" 
} = testimonialsPageData;
---

<BaseLayout title="TESTIMONIALS /// THE MARKETING CLUB (MAC)">
  <!-- 1. BREADCRUMB COMMAND STRIP -->
  <section class="w-full bg-tactical-stone border-b-2 border-stark-black">
    <div class="max-w-[1280px] mx-auto px-3.5 sm:px-6 lg:px-8 py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3">
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 min-w-0">
        <a 
          href="/blueprint"
          class="font-mono text-xs font-bold uppercase bg-pure-white hover:bg-mac-yellow text-stark-black px-2.5 py-1 border border-stark-black shadow-[2px_2px_0px_#000000] inline-flex items-center gap-1 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all mr-1 sm:mr-2 shrink-0"
        >
          <span class="material-symbols-outlined text-[14px]">arrow_back</span>
          <span>{backToBlueprintText}</span>
        </a>
        <span class="w-2.5 h-2.5 bg-system-red inline-block shrink-0"></span>
        <span class="font-mono text-xs sm:text-sm text-stark-black font-bold uppercase tracking-wider truncate">
          {breadcrumb}
        </span>
      </div>
      <div class="flex items-center gap-3 shrink-0 self-start sm:self-auto">
        <span class="font-mono text-[11px] text-stark-black font-bold uppercase bg-pure-white px-2 py-0.5 border border-stark-black shadow-[2px_2px_0px_#000000]">
          {securityTier}
        </span>
      </div>
    </div>
  </section>

  <!-- MAIN TESTIMONIALS CONTENT CONTAINER -->
  <div class="max-w-[1280px] w-full mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8 sm:space-y-12">
    
    <!-- 2. HERO SPOTLIGHT TERMINAL BANNER -->
    <header class="w-full border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] bg-pure-white relative">
      <!-- Blueprint Technical Corner Registration Crosshairs (Desktop Only) -->
      <span class="hidden sm:inline absolute -top-3.5 -left-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:inline absolute -top-3.5 -right-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:inline absolute -bottom-3.5 -left-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>
      <span class="hidden sm:inline absolute -bottom-3.5 -right-3.5 font-mono text-base font-black text-stark-black pointer-events-none select-none z-30">+</span>

      <!-- Terminal Window Bar -->
      <div class="min-h-12 h-auto py-2 sm:py-0 bg-stark-black px-3.5 sm:px-6 flex items-center justify-between border-b-4 border-stark-black gap-2">
        <div class="flex items-center gap-2 min-w-0 truncate">
          <span class="w-2.5 h-2.5 bg-mac-yellow inline-block animate-pulse shrink-0"></span>
          <span class="font-mono text-xs sm:text-sm font-bold text-mac-yellow uppercase tracking-wider truncate">
            {header.terminalTag}
          </span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span class="font-mono text-[11px] text-pure-white uppercase font-bold hidden sm:inline">
            ARCHIVE CLASSIFICATION: UNRESTRICTED
          </span>
          <span class="w-3 h-3 bg-mac-yellow border border-stark-black"></span>
        </div>
      </div>

      <!-- Banner Body -->
      <div class="p-4 sm:p-8 lg:p-10 bg-mac-yellow flex flex-col justify-between border-b-4 border-stark-black">
        <div class="max-w-4xl space-y-3 sm:space-y-4">
          <div class="inline-block bg-pure-white text-stark-black font-mono text-xs font-bold px-2.5 py-0.5 sm:px-3 sm:py-1 border-2 border-stark-black shadow-[2px_2px_0px_#000000] uppercase">
            {header.badge}
          </div>
          <h1 class="font-display text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-stark-black leading-[1.05] break-words">
            {header.title}
          </h1>
          <p class="font-sans text-sm sm:text-base lg:text-lg text-stark-black font-medium leading-relaxed max-w-3xl">
            {header.description}
          </p>
        </div>
      </div>

      <!-- Telemetry Metrics Triple Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-stark-black bg-tactical-stone font-mono text-xs font-bold">
        {stats.map((item: any) => (
          <div class="p-3.5 sm:p-4 flex flex-col items-start justify-center gap-0.5">
            <span class="text-on-surface-variant text-[11px] uppercase tracking-wider">{item.label}</span>
            <span class="text-stark-black text-sm sm:text-base font-black">{item.value}</span>
          </div>
        ))}
      </div>
    </header>

    <!-- CONNECTOR RAIL -->
    <BlueprintDivider tag="DECLASSIFIED_DOSSIER_RECORDS" code="ALUMNI_ARCHIVE_01" accent="yellow" class="my-6 sm:my-8" />

    <!-- 3. ARCHIVED TESTIMONIAL DOSSIERS LIST -->
    <section class="space-y-6 sm:space-y-8" id="testimonials-archive">
      {sortedTestimonials.map((person, idx) => (
        <article class="paper-lift border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[8px_8px_0px_#000000] bg-pure-white p-4 sm:p-6 lg:p-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 items-start">
            
            <!-- Left Portrait & Identifier -->
            <div class="md:col-span-3">
              <div class="relative border-2 border-stark-black bg-stark-black shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] aspect-square overflow-hidden max-w-[260px] sm:max-w-none mx-auto md:mx-0">
                <BrutalMedia
                  src={person.data.portraitImage}
                  videoUrl={person.data.videoTestimonialUrl}
                  alt={`${person.data.name} ${person.data.role}`}
                  ratio="1/1"
                  border={false}
                  class="w-full h-full"
                  mediaClass="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-300"
                />
                <div 
                  class="absolute bottom-2 left-2 bg-stark-black text-pure-white font-mono text-xs font-bold px-2 py-0.5 border border-pure-white z-10 copy-trigger cursor-copy hover:underline"
                  data-copy={person.data.badgeId}
                  title="CLICK TO COPY CALLSIGN ⧉"
                >
                  {person.data.badgeId}
                </div>
              </div>
            </div>

            <!-- Right Overview & Collapsible Drawer -->
            <div class="md:col-span-9 flex flex-col justify-between h-full space-y-3.5 sm:space-y-4">
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="font-display text-xl sm:text-2xl md:text-3xl font-black uppercase text-stark-black tracking-tight break-words">
                    {person.data.name}
                  </h2>
                  <span class={`font-mono text-xs font-bold uppercase ${
                    idx % 3 === 0 
                      ? "text-system-red font-black" 
                      : idx % 3 === 1 
                      ? "text-electric-cyan font-black bg-stark-black px-1.5 py-0.5" 
                      : "text-stark-black bg-mac-yellow px-1.5 py-0.5 border border-stark-black"
                  }`}>
                    /// {person.data.role}
                  </span>
                </div>

                <!-- Featured Pull Quote in Tactical Box -->
                <div class="mt-3 p-3.5 sm:p-4 bg-tactical-stone border-2 border-stark-black shadow-[2px_2px_0px_#000000]">
                  <p class="font-sans text-xs sm:text-sm md:text-base text-stark-black italic leading-relaxed">
                    {person.data.pullQuote}
                  </p>
                </div>
              </div>

              <!-- Collapsible Full Letter Drawer -->
              <div
                id={`drawer-alumni-${idx}`}
                class={`border-2 border-stark-black bg-surface-container-low p-3.5 sm:p-5 space-y-3 font-sans text-xs sm:text-sm md:text-base text-on-surface leading-relaxed ${
                  person.data.defaultOpen ? "block" : "hidden"
                }`}
              >
                {person.data.fullLetter.map((para: string) => (
                  <p>{para}</p>
                ))}
              </div>

              <!-- Action Controls: Expand/Collapse & LinkedIn Button -->
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3 pt-2">
                <button
                  type="button"
                  class={`font-mono text-xs sm:text-sm font-bold uppercase px-4 py-2.5 border-2 border-stark-black shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] cursor-pointer select-none transition-colors text-center justify-center dossier-toggle-btn ${
                    person.data.defaultOpen
                      ? "bg-stark-black text-mac-yellow hover:bg-mac-yellow hover:text-stark-black"
                      : "bg-mac-yellow text-stark-black hover:bg-stark-black hover:text-mac-yellow"
                  }`}
                  data-drawer-id={`drawer-alumni-${idx}`}
                  data-open-text={dossierOpenText}
                  data-close-text={dossierCloseText}
                >
                  {person.data.defaultOpen ? dossierCloseText : dossierOpenText}
                </button>

                {person.data.linkedinUrl && (
                  <a
                    href={person.data.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs sm:text-sm font-bold uppercase bg-pure-white text-stark-black px-4 py-2.5 border-2 border-stark-black shadow-[3px_3px_0px_#000000] sm:shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-pure-white active:translate-x-1 active:translate-y-1 active:shadow-none transition-all inline-flex items-center justify-center gap-1.5"
                  >
                    <span>{linkedinText}</span>
                  </a>
                )}
              </div>

            </div>

          </div>
        </article>
      ))}
    </section>

    <!-- BOTTOM RETURN STRIP -->
    <div class="pt-6 sm:pt-8 flex justify-center">
      <a
        href="/blueprint"
        class="arcade-btn w-full sm:w-auto justify-center bg-pure-white text-stark-black px-6 sm:px-8 py-3 sm:py-3.5 border-4 border-stark-black font-mono text-xs sm:text-sm font-bold uppercase shadow-[4px_4px_0px_#000000] sm:shadow-[6px_6px_0px_#000000] hover:bg-mac-yellow hover:text-stark-black flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        <span>{backToBlueprintText}</span>
      </a>
    </div>

  </div>

  <!-- CLIENT SCRIPT: Interactive Dossier Accordions -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const toggleButtons = document.querySelectorAll('.dossier-toggle-btn');

      toggleButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const drawerId = btn.getAttribute('data-drawer-id');
          if (!drawerId) return;
          const drawer = document.getElementById(drawerId);
          if (!drawer) return;

          const isHidden = drawer.classList.contains('hidden');
          const openTxt = btn.getAttribute('data-open-text') || '[ READ FULL DOSSIER + ]';
          const closeTxt = btn.getAttribute('data-close-text') || '[ CLOSE DOSSIER - ]';

          if (isHidden) {
            drawer.classList.remove('hidden');
            drawer.classList.add('block');
            btn.textContent = closeTxt;
            btn.classList.remove('bg-mac-yellow', 'text-stark-black');
            btn.classList.add('bg-stark-black', 'text-mac-yellow');
          } else {
            drawer.classList.add('hidden');
            drawer.classList.remove('block');
            btn.textContent = openTxt;
            btn.classList.remove('bg-stark-black', 'text-mac-yellow');
            btn.classList.add('bg-mac-yellow', 'text-stark-black');
          }
        });
      });
    });
  </script>
</BaseLayout>

---
interface Props {
  src?: string | null;
  alt?: string;
  ratio?: "1/1" | "16/9" | "3/4" | "auto";
  caption?: string;
  tag?: string;
  class?: string;
  imgClass?: string;
  border?: boolean;
  shadow?: boolean | string;
}

const {
  src,
  alt = "MAC Visual Archive Image",
  ratio = "auto",
  caption,
  tag,
  class: className = "",
  imgClass = "",
  border = true,
  shadow = false,
} = Astro.props;

// Aspect ratio mapping
const ratioClasses = {
  "1/1": "aspect-square",
  "16/9": "aspect-video",
  "3/4": "aspect-[3/4]",
  "auto": "aspect-auto",
};

const aspectClass = ratioClasses[ratio] || "aspect-auto";
const hasValidSrc = typeof src === "string" && src.trim().length > 0;

let shadowClass = "";
if (shadow === true) shadowClass = "shadow-brutal-sm";
else if (typeof shadow === "string") shadowClass = shadow;
---

<div class={`flex flex-col ${border ? "border-2 border-stark-black" : ""} ${shadowClass} ${className} bg-pure-white overflow-hidden`}>
  <!-- Image Frame with Aspect Ratio Lock -->
  <div class={`relative w-full ${aspectClass} overflow-hidden bg-tactical-stone flex items-center justify-center`}>
    
    <!-- Optional Technical Tag Overlay -->
    {tag && (
      <div class="absolute top-0 left-0 right-0 bg-stark-black text-pure-white font-mono text-[11px] px-3 py-1 border-b-2 border-stark-black flex justify-between items-center z-20 select-none">
        <span class="truncate">{tag}</span>
        <span class="text-mac-yellow shrink-0 ml-2 font-bold">ISO_800 // MAC_ARCHIVE</span>
      </div>
    )}

    {hasValidSrc ? (
      <>
        <!-- Real Image with object-fit: cover and onerror fallback hook -->
        <img
          src={src}
          alt={alt}
          loading="lazy"
          class={`w-full h-full object-cover block transition-transform duration-300 ${imgClass}`}
          onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
        />

        <!-- Hidden Fallback Box (revealed automatically if image network load fails) -->
        <div
          class="w-full h-full bg-mac-yellow border-2 border-stark-black p-4 flex flex-col items-center justify-center text-center select-none"
          style="display: none;"
          role="status"
          aria-label="Image failed to load placeholder"
        >
          <div class="w-10 h-10 border-2 border-stark-black bg-pure-white flex items-center justify-center mb-2 shadow-[2px_2px_0px_#000000]">
            <span class="material-symbols-outlined text-stark-black text-[22px]">image_not_supported</span>
          </div>
          <div class="font-mono text-xs font-black uppercase tracking-wider text-stark-black">
            /// VISUAL_ASSET_PENDING ///
          </div>
          <div class="font-mono text-[10px] text-stark-black/80 mt-1 uppercase">
            CLEARANCE: ARCHIVAL_STAMP_REQUIRED
          </div>
        </div>
      </>
    ) : (
      <!-- Immediate Fallback Box (when src is empty or not provided) -->
      <div 
        class="w-full h-full min-h-[160px] bg-mac-yellow border-2 border-stark-black p-4 flex flex-col items-center justify-center text-center select-none"
        role="status"
        aria-label="Image pending placeholder"
      >
        <div class="w-10 h-10 border-2 border-stark-black bg-pure-white flex items-center justify-center mb-2 shadow-[2px_2px_0px_#000000]">
          <span class="material-symbols-outlined text-stark-black text-[22px]">photo_camera</span>
        </div>
        <div class="font-mono text-xs font-black uppercase tracking-wider text-stark-black">
          /// VISUAL_ASSET_PENDING ///
        </div>
        <div class="font-mono text-[10px] text-stark-black/80 mt-1 uppercase">
          AWAITING_CMS_DISPATCH // 2026-27
        </div>
      </div>
    )}
  </div>

  <!-- Optional Bottom Caption Strip -->
  {caption && (
    <div class="bg-pure-white border-t-2 border-stark-black px-3 py-2 font-mono text-xs font-bold text-stark-black flex items-center justify-between select-none">
      <span class="truncate">{caption}</span>
      <span class="text-[10px] text-on-surface-variant font-medium shrink-0 ml-2 uppercase">[FIG_REF]</span>
    </div>
  )}
</div>

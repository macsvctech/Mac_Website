---
interface Props {
  promptTitle?: string;
  statusBadge?: string;
  headerColor?: string;
  textColor?: string;
  class?: string;
  bodyClass?: string;
}

const {
  promptTitle = "> COMMAND_MODULE",
  statusBadge,
  headerColor = "#000000",
  textColor = "#F0C903",
  class: className = "",
  bodyClass = "p-6 md:p-8",
} = Astro.props;
---

<div class={`border-4 border-stark-black shadow-brutal-lg bg-pure-white relative overflow-hidden ${className}`}>
  <!-- 48px Top Terminal Header Bar -->
  <div 
    class="h-12 border-b-2 border-stark-black px-4 flex items-center justify-between select-none"
    style={`background-color: ${headerColor}; color: ${textColor};`}
  >
    <!-- Left: Terminal Prompt & Status Lights -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 bg-system-red border border-stark-black inline-block"></span>
        <span class="w-2.5 h-2.5 bg-mac-yellow border border-stark-black inline-block"></span>
        <span class="w-2.5 h-2.5 bg-electric-cyan border border-stark-black inline-block"></span>
      </div>
      <span class="font-mono text-xs sm:text-sm font-bold tracking-wider uppercase truncate">
        {promptTitle}
      </span>
    </div>

    <!-- Right: Status Badge or Terminal Icon -->
    <div class="flex items-center gap-2 shrink-0">
      {statusBadge ? (
        <span class="font-mono text-[11px] font-extrabold uppercase px-2 py-0.5 border border-current bg-transparent">
          {statusBadge}
        </span>
      ) : (
        <span class="font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-mac-yellow animate-pulse inline-block"></span>
          <span>RELAY_OK</span>
        </span>
      )}
    </div>
  </div>

  <!-- Terminal Card Body -->
  <div class={bodyClass}>
    <slot />
  </div>
</div>

---
interface Props {
  title?: string;
  description?: string;
}

import '../styles/global.css';
import settings from '../content/settings/global.json';
import BrutalFileDownload from '../components/ui/BrutalFileDownload.astro';

const { 
  title = settings.siteTitle, 
  description = "The official marketing society of Sri Venkateswara College. We don't just follow trends, we build the campaigns that define them." 
} = Astro.props;

// Active route detection logic
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = (settings.navigation || []).map((item) => ({
  name: item.name,
  href: item.href,
  active: item.href === "/" 
    ? pathname === "/" 
    : pathname === item.href || pathname.startsWith(item.href + "/"),
}));

const headerCta = settings.headerCta || {
  text: "[JOIN THE CLUB ->]",
  link: "/contact",
  mobileNumber: "06",
  mobileLabel: "JOIN THE CLUB [CONTACT]",
  mobileActiveBadge: "[ACTIVE]",
  mobileInactiveBadge: "[APPLY ->]"
};

const mobileMenu = settings.mobileMenu || {
  openText: "[ MENU ≡ ]",
  closeText: "[ CLOSE X ]",
  activeBadge: "[ACTIVE]",
  openBadge: "[OPEN ->]"
};

const footer = settings.footer || {
  brandAcronym: "MAC",
  collegeSub: "SRI VENKATESWARA COLLEGE // DU",
  telPrefix: "TEL: ",
  mailPrefix: "/// MAIL: ",
  socialLinks: [],
  copyright: "© 2026-27 THE MARKETING CLUB, SVC.\nALL RIGHTS RESERVED.",
  statusBadge: "[ALL RELAYS SECURED // STATUS: LIVE]"
};

const isContactActive = pathname === headerCta.link || pathname.startsWith(headerCta.link + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={settings.faviconUrl || "/logo.svg"} />
    <title>{title}</title>

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/uploads/images/screens/home-screen.png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/uploads/images/screens/home-screen.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" 
      rel="stylesheet" 
    />
    <link 
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" 
      rel="stylesheet" 
    />
  </head>
  <body class="bg-surface text-on-surface antialiased min-h-screen flex flex-col selection:bg-stark-black selection:text-mac-yellow">
    
    <!-- STICKY MASTER HEADER (Ceiling Banner + Navigation + Mobile Drawer) -->
    <header class="sticky top-0 left-0 right-0 z-50 w-full bg-surface">
      <!-- 1. TOP CAUTION-TAPE RECRUITMENT BANNER (Conditioned on recruitmentBanner.enabled) -->
      {settings.recruitmentBanner?.enabled && (
        <a 
          href={settings.recruitmentBanner?.link || "/roster"}
          data-sfx="transmit" 
          class="block w-full bg-mac-yellow border-b-2 border-stark-black py-2 px-4 text-center select-none hover:bg-stark-black hover:text-mac-yellow transition-colors group cursor-pointer"
        >
          <div class="font-mono font-bold uppercase text-xs md:text-sm tracking-wider text-stark-black group-hover:text-mac-yellow truncate text-center">
            {settings.recruitmentBanner.text}
          </div>
        </a>
      )}

      <!-- 2. STICKY BRUTALIST NAVBAR -->
      <div class="w-full h-16 sm:h-20 bg-surface border-b-4 border-stark-black">
        <div class="max-w-[1280px] mx-auto h-full px-3.5 sm:px-6 md:px-8 flex items-center justify-between gap-3 sm:gap-4">
          
          <!-- Far Left: Logo & Organization Brand Identity -->
          <a href="/" class="flex items-center gap-2.5 sm:gap-3 shrink-0 group focus:outline-none min-w-0">
            <img 
              src={settings.logoUrl || "/logo.svg"} 
              alt="Official MAC TV Speech-Bubble Logo" 
              class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105 shrink-0" 
              height="44"
              width="44"
            />
            <div class="flex flex-col min-w-0">
              <span class="font-display font-black text-base sm:text-xl lg:text-2xl tracking-tighter uppercase text-stark-black leading-none group-hover:text-primary transition-colors truncate">
                {settings.shortTitle}
              </span>
              <span class="font-mono text-[9px] sm:text-xs font-bold text-on-surface-variant tracking-wider uppercase mt-0.5 sm:mt-1 leading-none truncate">
                {settings.college} // DU
              </span>
            </div>
          </a>

          <!-- Center (Desktop >=768px): Navigation Tabs with Active Route Highlighting -->
          <nav class="hidden md:flex items-center gap-1.5 lg:gap-2">
            {navLinks.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class={`font-mono text-xs lg:text-sm font-bold uppercase tracking-wider px-3 lg:px-4 py-2 transition-all ${
                  item.active
                    ? "bg-mac-yellow text-stark-black border-2 border-stark-black shadow-[2px_2px_0px_#000000]"
                    : "text-stark-black border-2 border-transparent hover:bg-stark-black hover:text-mac-yellow hover:border-stark-black"
                }`}
              >
                {item.name}
              </a>
            ))}
          </nav>

          <!-- Far Right: Arcade CTA & Mobile Toggle Button -->
          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- Brutalist Tactile SFX ON/OFF Toggle Button -->
            <button
              id="mac-sfx-toggle-btn"
              type="button"
              class="mac-sfx-toggle inline-flex items-center gap-1.5 font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider border-2 border-stark-black px-2 sm:px-2.5 py-1.5 bg-pure-white text-stark-black shadow-[2px_2px_0px_#000000] hover:bg-mac-yellow hover:text-stark-black transition-none cursor-pointer select-none"
              aria-label="Toggle Sound Effects (SFX)"
              aria-pressed="true"
              title="TOGGLE TACTILE AUDIO & SFX [DEFAULT: ON]"
            >
              <span class="sfx-status-dot w-2 h-2 bg-mac-yellow border border-stark-black shrink-0"></span>
              <span class="sfx-status-text">SFX ON</span>
            </button>

            <!-- Desktop Arcade CTA Button -->
            <a
              href={headerCta.link}
              class={`hidden sm:inline-flex items-center justify-center font-mono text-xs lg:text-sm font-bold uppercase tracking-wider border-2 border-stark-black px-4 py-2 transition-all ${
                isContactActive
                  ? "bg-stark-black text-mac-yellow translate-x-[2px] translate-y-[2px] shadow-none"
                  : "arcade-btn-sm bg-mac-yellow text-stark-black shadow-[4px_4px_0px_#000000] hover:bg-stark-black hover:text-mac-yellow"
              }`}
            >
              {headerCta.text}
            </a>

            <!-- Mobile Hamburger Arcade Button (<768px) -->
            <button
              id="mobile-menu-btn"
              type="button"
              class="md:hidden arcade-btn-sm bg-mac-yellow text-stark-black px-2.5 py-1.5 font-mono text-xs font-bold border-2 border-stark-black shadow-[3px_3px_0px_#000000] focus:outline-none shrink-0"
              aria-label="Toggle Navigation Menu"
              aria-expanded="false"
              aria-controls="mobile-nav-drawer"
              data-open-text={mobileMenu.openText}
              data-close-text={mobileMenu.closeText}
            >
              {mobileMenu.openText}
            </button>
          </div>

        </div>
      </div>

      <!-- 3. MOBILE MENU DROPDOWN DRAWER (<768px) -->
      <div 
        id="mobile-nav-drawer" 
        class="hidden md:hidden w-full bg-tactical-stone border-b-4 border-stark-black shadow-brutal divide-y-2 divide-stark-black max-h-[calc(100vh-4.5rem)] overflow-y-auto"
      >
        <!-- Mobile SFX Control Strip -->
        <div class="p-3.5 sm:p-4 bg-tactical-stone flex items-center justify-between font-mono text-xs font-bold uppercase tracking-wider">
          <span class="text-stark-black flex items-center gap-1.5">
            <span class="w-2 h-2 bg-mac-yellow inline-block border border-stark-black"></span>
            TACTILE SFX [AUDIO]
          </span>
          <button
            id="mobile-sfx-toggle-btn"
            type="button"
            class="mac-sfx-toggle inline-flex items-center gap-1.5 font-mono text-[11px] font-bold uppercase tracking-wider border-2 border-stark-black px-2.5 py-1 bg-pure-white text-stark-black shadow-[2px_2px_0px_#000000] hover:bg-mac-yellow transition-none cursor-pointer select-none"
            aria-label="Toggle Sound Effects (SFX)"
            aria-pressed="true"
          >
            <span class="sfx-status-dot w-2 h-2 bg-mac-yellow border border-stark-black shrink-0"></span>
            <span class="sfx-status-text">SFX ON</span>
          </button>
        </div>
        {navLinks.map((item, idx) => (
          <a
            href={item.href}
            class={`block p-3.5 sm:p-4 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors flex items-center justify-between ${
              item.active 
                ? "bg-mac-yellow text-stark-black font-black" 
                : "bg-pure-white text-stark-black hover:bg-mac-yellow"
            }`}
          >
            <span>0{idx + 1} // {item.name}</span>
            <span class="text-xs">
              {item.active ? mobileMenu.activeBadge : mobileMenu.openBadge}
            </span>
          </a>
        ))}
        <!-- Final Link: Join The Club / Contact -->
        <a
          href={headerCta.link}
          class={`block p-3.5 sm:p-4 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors flex items-center justify-between ${
            isContactActive 
              ? "bg-stark-black text-mac-yellow font-black" 
              : "bg-electric-cyan text-stark-black hover:bg-stark-black hover:text-electric-cyan"
          }`}
        >
          <span>{headerCta.mobileNumber} // {headerCta.mobileLabel}</span>
          <span class="text-xs">{isContactActive ? headerCta.mobileActiveBadge : headerCta.mobileInactiveBadge}</span>
        </a>
      </div>
    </header>

    <!-- MAIN PAGE CONTENT SLOT -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- CAUTION-TAPE SLASH RIBBON (Above Footer) -->
    <aside class="w-full bg-mac-yellow border-t-2 border-b-2 border-stark-black py-2.5 overflow-hidden select-none">
      <div class="animate-marquee-tape whitespace-nowrap flex gap-4 text-center font-mono text-xs md:text-sm font-extrabold text-stark-black tracking-widest uppercase">
        <span class="shrink-0">{settings.footerMarquee}</span>
        <span class="shrink-0">{settings.footerMarquee}</span>
        <span class="shrink-0">{settings.footerMarquee}</span>
        <span class="shrink-0">{settings.footerMarquee}</span>
      </div>
    </aside>

    <!-- STARK BLACK BRUTALIST FOOTER -->
    <footer class="w-full bg-stark-black text-pure-white border-t-4 border-stark-black">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-12">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-start md:items-center">
          
          <!-- Col 1: Brand & College Coordinates -->
          <div class="md:col-span-5 flex flex-col space-y-2">
            <span class="font-display font-black text-2xl sm:text-3xl md:text-4xl text-mac-yellow leading-none tracking-tight">
              {footer.brandAcronym}
            </span>
            <span class="font-mono text-xs font-bold text-pure-white uppercase tracking-wider">
              {settings.siteTitle}
            </span>
            <p class="font-mono text-[11px] text-tactical-stone leading-relaxed max-w-sm pt-1">
              {settings.address}
            </p>
            <div class="font-mono text-[11px] text-electric-cyan pt-1 flex flex-wrap gap-x-2 gap-y-1">
              <span>{footer.telPrefix}<button type="button" class="underline hover:text-mac-yellow copy-trigger transition-colors" data-copy={settings.phone} title="CLICK TO COPY PHONE">{settings.phone}</button></span> 
              <span>{footer.mailPrefix}<button type="button" class="underline hover:text-mac-yellow copy-trigger transition-colors" data-copy={settings.email} title="CLICK TO COPY EMAIL">{settings.email}</button></span>
            </div>
            {settings.brochurePdfEnabled === true && settings.brochurePdfUrl && settings.brochurePdfUrl.trim().length > 0 && settings.brochurePdfUrl.trim() !== '#' && (
              <div class="pt-2">
                <BrutalFileDownload
                  fileUrl={settings.brochurePdfUrl}
                  fileLabel={settings.brochureLabel || "SOCIETY BROCHURE [PDF]"}
                  fileType="PDF"
                  enabled={settings.brochurePdfEnabled}
                />
              </div>
            )}
          </div>

          <!-- Col 2: Social Links & Archives -->
          <div class="md:col-span-4 flex flex-wrap items-center justify-start md:justify-center gap-2 font-mono text-xs">
            {(footer.socialLinks || []).map((social) => (
              <a 
                href={social.url} 
                target={social.external ? "_blank" : undefined} 
                rel={social.external ? "noopener noreferrer" : undefined} 
                class="border border-tactical-stone px-2.5 py-1 text-pure-white hover:bg-mac-yellow hover:text-stark-black hover:border-mac-yellow transition-colors"
              >
                {social.label}
              </a>
            ))}
          </div>

          <!-- Col 3: Copyright & Security Clearance Status -->
          <div class="md:col-span-3 text-left md:text-right space-y-1.5">
            <p class="font-mono text-[11px] text-tactical-stone uppercase tracking-wide whitespace-pre-line">
              {footer.copyright}
            </p>
            <div class="pt-1">
              <span class="inline-block bg-primary-container text-stark-black font-mono text-[10px] font-bold px-2 py-0.5 border border-stark-black">
                {footer.statusBadge}
              </span>
            </div>
          </div>

        </div>
      </div>
    </footer>

    <!-- BRUTALIST MECHANICAL CLIPBOARD TOAST HUD (ITEM 5) -->
    <div 
      id="brutal-clipboard-toast" 
      class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-[9999] bg-mac-yellow text-stark-black border-4 border-stark-black shadow-[4px_4px_0px_#000000] sm:shadow-[6px_6px_0px_#000000] p-3 sm:p-4 font-mono font-black text-xs uppercase flex items-center gap-2.5 sm:gap-3 transition-transform duration-150 translate-y-36 pointer-events-none select-none max-w-[calc(100vw-2rem)] sm:max-w-md"
      role="status"
      aria-live="polite"
    >
      <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-stark-black inline-block animate-pulse shrink-0"></span>
      <div class="flex flex-col gap-0.5 min-w-0 truncate">
        <span class="text-[10px] text-[#705d00] tracking-wider font-bold">/// BUFFER_STAMP // 200 OK</span>
        <span class="truncate">[✓] COPIED: <span id="brutal-toast-value" class="text-stark-black underline"></span></span>
      </div>
    </div>

    <!-- CLIENT SCRIPT: Mobile Menu Toggle Behavior & Tactical Copy Handler -->
    <script is:inline>
      (function() {
        const btn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-nav-drawer');
        
        if (btn && drawer) {
          const openTxt = btn.getAttribute('data-open-text') || '[ MENU ≡ ]';
          const closeTxt = btn.getAttribute('data-close-text') || '[ CLOSE X ]';

          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isHidden = drawer.classList.contains('hidden');
            if (isHidden) {
              drawer.classList.remove('hidden');
              btn.textContent = closeTxt;
              btn.setAttribute('aria-expanded', 'true');
            } else {
              drawer.classList.add('hidden');
              btn.textContent = openTxt;
              btn.setAttribute('aria-expanded', 'false');
            }
          });

          // Close drawer on click outside
          document.addEventListener('click', function(e) {
            if (!drawer.contains(e.target) && !btn.contains(e.target)) {
              drawer.classList.add('hidden');
              btn.textContent = openTxt;
              btn.setAttribute('aria-expanded', 'false');
            }
          });

          // Close on escape key
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
              drawer.classList.add('hidden');
              btn.textContent = openTxt;
              btn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // Tactical Clipboard Handler (Item 5)
        const toast = document.getElementById('brutal-clipboard-toast');
        const toastVal = document.getElementById('brutal-toast-value');
        let hideTimer = null;

        function showClipboardToast(text) {
          if (!toast || !toastVal) return;
          const displayTxt = text.length > 36 ? text.substring(0, 36) + '...' : text;
          toastVal.textContent = displayTxt;
          toast.classList.remove('translate-y-36');
          toast.classList.add('translate-y-0');

          if (hideTimer) clearTimeout(hideTimer);
          hideTimer = setTimeout(function() {
            toast.classList.remove('translate-y-0');
            toast.classList.add('translate-y-36');
          }, 2400);
        }

        document.addEventListener('click', function(e) {
          const trigger = e.target.closest('[data-copy], .copy-trigger');
          if (trigger) {
            const rawVal = trigger.getAttribute('data-copy') || trigger.innerText.trim();
            if (rawVal && navigator.clipboard) {
              navigator.clipboard.writeText(rawVal).then(function() {
                showClipboardToast(rawVal);
                trigger.classList.add('copy-flash-active');
                setTimeout(function() {
                  trigger.classList.remove('copy-flash-active');
                }, 400);
              }).catch(function() {
                showClipboardToast(rawVal);
              });
            }
          }
        });
      })();
    </script>
    <!-- Brutalist Tactile & Web Audio Synthesizer Controller -->
    <script src="../scripts/sfx.js"></script>
  </body>
</html>
